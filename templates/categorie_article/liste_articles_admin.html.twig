{% extends 'base2.html.twig' %}

{% block title %}Liste des articles{% endblock %}

{% block body %}

<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
        .pagination .page-link {
        color: #138A4B !important;  /* Texte vert */
        background-color: white !important; /* Fond blanc */
        border-color: #138A4B !important; /* Bordure verte */
    }

    .pagination .page-item.active .page-link {
        background-color: #0F6B3D !important; /* Fond vert foncé */
        color: white !important; /* Texte blanc */
        border-color: #0F6B3D !important;
    }

    .pagination .page-link:hover {
        background-color: #A5D6A7 !important; /* Vert clair au survol */
        color: #0F6B3D !important; /* Texte vert foncé */
    }

    .pagination .page-item:first-child .page-link,
    .pagination .page-item:last-child .page-link {
        background-color: #138A4B !important; /* Fond vert pour Précédent et Suivant */
        color: white !important; /* Texte blanc */
        border-color: #138A4B !important;
    }

    .pagination .page-item:first-child .page-link:hover,
    .pagination .page-item:last-child .page-link:hover {
        background-color: #A5D6A7 !important; /* Vert clair au survol */
        color: #0F6B3D !important; /* Texte vert foncé */
    }

    
</style>

<main id="main" class="main">
{% for message in app.flashes('success') %}
    <div class="alert alert-success alert-dismissible fade show d-flex justify-content-between align-items-center" role="alert">
        <span>{{ message }}</span>
        <span class="close-icon" style="cursor: pointer;" data-bs-dismiss="alert" aria-label="Close">
            X
        </span>
    </div>
{% endfor %}



    <section class="section dashboard">
        <div class="row">
            <div class="col-12">
                <div class="card top-selling overflow-auto">

                    <div class="card-body pb-0">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5 class="card-title mb-0">Tous les articles proposés chez RecyConnect</h5>
                                <div style="width: 300px;">
                                    <select id="inputState" class="form-select" onchange="filterArticles(this.value)">
                                        <option value="all">Toutes les catégories</option>
                                        {% for categorie in categories %}
                                            <option value="{{ categorie.id }}">{{ categorie.nomCategorie }}</option>
                                        {% endfor %}
                                    </select>
                                </div>
                            </div>
                            <table class="table table-borderless" id="articlesTable">
                                <thead>
                                    <tr>
                                        <th scope="col">#</th>
                                        <th scope="col">Image</th>
                                        <th scope="col">Nom de l'article</th>
                                        <th scope="col">Catégorie</th>
                                        <th scope="col">Quantité</th>
                                        <th scope="col">Prix unitaire</th>
                                        <th scope="col">Propriétaire</th>
                                        <th scope="col"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for article in articles %}
                                        <tr>
                                            <th scope="row">{{ loop.index }}</th>
                                            <td><img src="{{ asset('uploads/photo_dir/' ~ article.imageArticle) }}" alt="Image" height="60" width="70"></td>
                                            <td>{{ article.nomArticle }}</td>
                                            <td>{{ article.categorie.nomCategorie }}</td>
                                            <td>{{ article.quantiteArticle }} KG</td>
                                            <td>{{ article.prix }} TN/KG</td>
                                            <td>{{ article.utilisateur.nomUser }} {{ article.utilisateur.prenom }}</td>
                                            <td>
                                                <a class="btn btn-danger detail-button" href="{{ path('app_deleteArticleAdmin', {'id': article.id}) }}">
                                                    <i class="bi bi-trash"></i> Ban
                                                </a>
                                            </td>
                                        </tr>
                                    {% else %}
                                        <tr>
                                            <td colspan="8" class="text-center">Aucun article trouvé</td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                            <nav aria-label="Page navigation">
                                <ul class="pagination">
                                    {{ knp_pagination_render(articles) }}
                                </ul>
                            </nav>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

</main>

<script>
    function filterArticles(category) {
        fetch('/Article/getall/admin/' + encodeURIComponent(category))
            .then(response => response.text())
            .then(data => {
                const parser = new DOMParser();
                const doc = parser.parseFromString(data, 'text/html');
                const newContent = doc.querySelector('#articlesTable').innerHTML;
                document.querySelector('#articlesTable').innerHTML = newContent;
            })
            .catch(error => console.error('Erreur:', error));
    }
</script>
{% endblock %}
