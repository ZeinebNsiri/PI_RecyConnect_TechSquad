{% extends 'base2.html.twig' %}

{% block title %}Catégories article{% endblock %}

{% block body %}

<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
            .pagination .page-link {
        color: #138A4B !important;  /* Texte vert */
        background-color: white !important; /* Fond blanc */
        border-color: #138A4B !important; /* Bordure verte */
    }

    .pagination .page-item.active .page-link {
        background-color: #0F6B3D !important; /* Fond vert foncé */
        color: white !important; /* Texte blanc */
        border-color: #0F6B3D !important;
    }

    .pagination .page-link:hover {
        background-color: #A5D6A7 !important; /* Vert clair au survol */
        color: #0F6B3D !important; /* Texte vert foncé */
    }

    .pagination .page-item:first-child .page-link,
    .pagination .page-item:last-child .page-link {
        background-color: #138A4B !important; /* Fond vert pour Précédent et Suivant */
        color: white !important; /* Texte blanc */
        border-color: #138A4B !important;
    }

    .pagination .page-item:first-child .page-link:hover,
    .pagination .page-item:last-child .page-link:hover {
        background-color: #A5D6A7 !important; /* Vert clair au survol */
        color: #0F6B3D !important; /* Texte vert foncé */
    }
</style>

<main id="main" class="main">

{% for message in app.flashes('success') %}
    <div class="alert alert-success alert-dismissible fade show d-flex justify-content-between align-items-center" role="alert">
        <span>{{ message }}</span>
        <span class="close-icon" style="cursor: pointer;" data-bs-dismiss="alert" aria-label="Close">
            X
        </span>
    </div>
{% endfor %}

{% for error in form.vars.errors %}
    <div class="alert alert-danger">{{ error.message }}</div>
{% endfor %}

 {% for type, messages in app.flashes %}
                        {% for message in messages %}
                            <div class="alert alert-{{ type }} alert-dismissible fade show d-flex justify-content-between align-items-center" role="alert">
                                <span>{{ message }}</span>
                                <span class="close-icon" style="cursor: pointer; margin-left: 10px;" data-bs-dismiss="alert" aria-label="Close">
                                    X
                                </span>

                            </div>
                        {% endfor %}
                    {% endfor %}


    <div class="pagetitle">
        <h4>Les catégories des articles proposés</h4>
    </div><!-- End Page Title -->

    <div class="card">
        <div class="card-body">
            <h5 class="card-title">Ajouter une nouvelle catégorie</h5>

            <!-- Floating Labels Form -->
            {{ form_start(form, {'attr': {'class': 'row g-3', 'novalidate': 'novalidate', 'enctype': 'multipart/form-data'} }) }}
            
            <div class="col-md-12">
                <div class="form-floating">
                    {{ form_widget(form.nom_categorie, {'attr': {'class': 'form-control', 'placeholder': 'Nom de la catégorie', 'id': 'floatingName'}}) }}
                      {% if form.nom_categorie.vars.errors|length > 0 %}
                        <div class="alert alert-danger mt-2">
                            {{ form_errors(form.nom_categorie) }}
                        </div>
                    {% endif %}
                    
                    <label for="floatingName">Nom de la catégorie</label>
                </div>
            </div>

            <div class="col-12">
                <div class="form-floating">
                    {{ form_widget(form.description_categorie, {'attr': {'class': 'form-control', 'placeholder': 'Description', 'id': 'floatingTextarea', 'style': 'height: 100px;'}}) }}
                    {% if form.description_categorie.vars.errors|length > 0 %}
                        <div class="alert alert-danger mt-2">
                            {{ form_errors(form.description_categorie) }}
                        </div>
                    {% endif %}
                    <label for="floatingTextarea">Description</label>
                </div>
            </div>

            <div class="col-12">
                <div class="form-floating">
                    {{ form_widget(form.image_categorie, {'attr': {'class': 'form-control', 'id': 'floatingImage', 'accept': 'image/*'}}) }}
                    {% if form.image_categorie.vars.errors|length > 0 %}
                        <div class="alert alert-danger mt-2">
                            {{ form_errors(form.image_categorie) }}
                        </div>
                    {% endif %}
                    <label for="floatingImage">Image</label>
                </div>
                
            </div>

            <div class="text-center">
                {{ form_widget(form.Confirmer, {'attr': {'class': 'btn btn-success ' }}) }}
                {{ form_widget(form.Annuler, {'attr': {'class': 'btn btn-secondary', 'type': 'reset'}}) }}
            </div>

            {{ form_end(form) }}
            <!-- End floating Labels Form -->

        </div>
    </div>

    <section class="section dashboard">
        <div class="row">
            <div class="col-12">
                <div class="card top-selling overflow-auto">
                
            
                    <div class="card-body pb-0">
                        <h5 class="card-title">Toutes les catégories</h5>
                        <table class="table table-borderless">
                            <thead>
                                <tr>
                                    <th scope="col">#</th>
                                    <th scope="col">Logo</th>
                                    <th scope="col">Catégorie</th>
                                    <th scope="col">Nombre des articles</th>
                                    <th scope="col"></th>
                                    <th scope="col"></th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for categorie in categories %}
                                    <tr>
                                        <th scope="row">{{ loop.index }}</th>
                                        <td><img src="{{ asset('uploads/photo_dir/' ~ categorie.imageCategorie) }}" alt="Image" height: 60px width: 70px  ></td>
                                        <td>{{ categorie.nomCategorie }} </td>
                                        <td>{{ articleCounts[categorie.id] }}</td>
                                        <td class="fw-bold">
                                          <a href='{{ path ('pp_updateCategorieArticle' , { 'id':categorie.id } ) }}' class="btn btn-success"><i class="bi bi-pencil-square"></i> Modifier</a>
                                        </td>
                                        <td>
                                            <a class="btn btn-danger delete-btn"data-url="{{ path('app_deleteCategorieArticle', {'id': categorie.id}) }}"data-entity="CategorieArticle"data-genre="f"><i class="bi bi-trash"></i> Supprimer</a>
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="3" class="text-center">Aucune catégorie trouvée</td>
                                    </tr>
                                
                                {% endfor %}
                            </tbody>
                        </table>
                        <nav aria-label="Page navigation">
                                <ul class="pagination">
                                    {{ knp_pagination_render(categories) }}
                                </ul>
                            </nav>
                    </div>
                </div>
            </div>
        </div>
    </section>

</main>
{% endblock %}
