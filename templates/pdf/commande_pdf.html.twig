<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Facture</title>
    <style>
        body {
            font-family: 'Arial', sans-serif;
            font-size: 14px;
            margin: 0;
            padding: 0;
            background-color: #f4f7fc;
        }
        .container {
            width: 80%;
            margin: 30px auto;
            background-color: #ffffff;
            padding: 30px;
            border-radius: 10px;
            box-shadow: 0 6px 15px rgba(0, 0, 0, 0.1);
        }
        .header {
            text-align: center;
            margin-bottom: 20px;
        }
        .header img {
            width: 150px;
            margin-bottom: 10px;
        }
        h2 {
            font-size: 24px;
            color: #333;
            margin-top: 10px;
        }
        .user-info {
            margin-top: 25px;
            margin-bottom: 30px;
        }
        .user-info p {
            font-size: 16px;
            color: #555;
            margin: 5px 0;
        }
        .order-details {
            margin-top: 20px;
        }
        .order-details table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
            font-size: 16px;
        }
        .order-details th, .order-details td {
            padding: 12px 20px;
            text-align: left;
            border: 1px solid #ddd;
        }
        .order-details th {
            background-color: #f9f9f9;
            color: #333;
            font-weight: bold;
        }
        .total-amount {
            text-align: right;
            font-size: 18px;
            font-weight: bold;
            margin-top: 20px;
            color: #333;
        }
    </style>
</head>
<body>

<div class="container">
    <div class="header">
        <img src="{{ asset('backOffice/assets/img/mainlogo.png') }}" alt="Logo">
        <h2>Facture de Commande</h2>
    </div>

    <div class="user-info">
        <p><strong>Nom de l'utilisateur :</strong> {{ utilisateur.firstName }} {{ utilisateur.lastName }}</p>
        <p><strong>Date :</strong> {{ "now"|date("Y-m-d") }}</p>
    </div>

    <div class="order-details">
        <h3>Détails de la Commande</h3>
        <table>
            <thead>
                <tr>
                    <th>ID Commande</th>
                    <th>Date de Commande</th>
                    <th>Montant Total (TND)</th>
                </tr>
            </thead>
            <tbody>
                {% for commande in commandes %}
                    <tr>
                        <td>{{ commande.id }}</td>
                        <td>{{ commande.dateCommande | date('Y-m-d') }}</td>
                        <td>{{ commande.prixTotal }} TND</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <div class="total-amount">
        <p><strong>Total à payer : {{ totalAmount }} TND</strong></p>
    </div>
</div>

</body>
</html>
