{% block title %}Facture{% endblock %}

{% block body %}
<main id="main" class="main">
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
            background-color: #f4f4f4;
        }

        .container {
            width: 100%;
            max-width: 800px;
            margin: 0 auto;
            padding: 20px;
            background-color: #fff;
        }

        .invoice-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            padding-bottom: 20px;
            border-bottom: 2px solid #ddd;
        }

        .invoice-details {
            text-align: left; /* Aligner à gauche */
        }

        .invoice-details h1 {
            font-size: 24px;
            margin: 0;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }

        th, td {
            padding: 10px;
            border: 1px solid #ddd;
            text-align: left;
        }

        th {
            background-color: #4CAF50;
            color: white;
        }

        tr.total-row {
            font-weight: bold;
            background-color: #e6f7e6;
        }

        .footer {
            text-align: center;
            margin-top: 20px;
            font-size: 14px;
            color: #777;
        }

        .logo-img {
            position: absolute;
            top: 10px;
            right: 20px;
            max-width: 150px;
        }
    </style>

    <!-- Logo en haut à droite -->
    <div class="logo">
        <img src="{{ asset('assets/backOffice/assets/img/mainlogo.png') }}" alt="" class="logo-img">
    </div>

    <div class="container">
        <div class="invoice-header">
            <!-- Le logo est déjà ajouté, donc pas besoin ici -->
            <div class="invoice-details">
                <p><strong>Numéro de Facture :</strong> {{ commande.id }}</p>
                <p><strong>Date :</strong> {{ "now"|date("d/m/Y") }}</p>
            </div>
        </div>

        <table>
            <thead>
                <tr>
                    <th colspan="2">Informations du client</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><strong>Nom et Prénom :</strong> {{ utilisateur.NomUser }} {{ utilisateur.Prenom }}</td>
                    <td><strong>Adresse :</strong> {{ utilisateur.adresse }}</td>
                </tr>
            </tbody>
        </table>

        <table>
            <thead>
                <tr>
                    <th>Article</th>
                    <th>Quantité</th>
                    <th>Prix Unitaire (DT)</th>
                    <th>Total (DT)</th>
                </tr>
            </thead>
            <tbody>
                {% for item in lignesCommande %}
                <tr>
                    <td>{{ item.getArticleC().getNomArticle() }}</td>
                    <td>{{ item.getQuantiteC() }}</td>
                    <td>{{ item.getPrixC() }}</td>
                    <td>{{ item.getPrixC() * item.getQuantiteC() }}</td>
                </tr>
                {% endfor %}
                <tr class="total-row">
                    <td colspan="3" style="text-align: right;">Total à payer :</td>
                    <td>{{ total }} DT</td>
                </tr>
            </tbody>
        </table>

        <div class="footer">
            <p>Merci pour votre commande !</p>
        </div>
    </div>
</main>
{% endblock %}
