{% block title %}Facture{% endblock %}

{% block body %}
<main id="main" class="main">
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 20px;
            padding: 20px;
            background-color: #f4f4f4;
        }

        h1 {
            color: #008000;
            text-align: center;
            border-bottom: 3px solid #008000;
            padding-bottom: 10px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
        }

        th, td {
            border: 1px solid black;
            padding: 10px;
            text-align: left;
        }

        th {
            background-color: #008000;
            color: white;
        }

        tr:nth-child(even) {
            background-color: #f2f2f2;
        }

        .logo-img {
            width: 100px;
            position: absolute;
            top: 10px;
            left: 10px;
        }
    </style>

<img src="{{ asset('backOffice/assets/img/mainlogo.png') }}" alt="Logo" class="logo-img">

    <h1>Facture</h1>
    
    <p><strong>Numéro de Facture :</strong> {{ commande.id }}</p>
    <p><strong>Date :</strong> {{ "now"|date("d/m/Y") }}</p>

    <h2>Informations du Client</h2>
    <table>
        <tr>
            <td><strong>Nom et Prénom :</strong> {{ utilisateur.NomUser }} {{ utilisateur.Prenom }}</td>
            <td><strong>Adresse :</strong> {{ utilisateur.adresse }}</td>
        </tr>
    </table>

    <h2>Détails de la Commande</h2>
    <table>
        <thead>
            <tr>
                <th>Article</th>
                <th>Quantité</th>
                <th>Prix Unitaire (DT)</th>
                <th>Total (DT)</th>
            </tr>
        </thead>
        <tbody>
            {% for item in lignesCommande %}
            <tr>
                <td>{{ item.getArticleC().getNomArticle() }}</td>
                <td>{{ item.getQuantiteC() }}</td>
                <td>{{ item.getPrixC() }}</td>
                <td>{{ item.getPrixC() * item.getQuantiteC() }}</td>
            </tr>
            {% endfor %}
            <tr>
                <td colspan="3" style="text-align: right;"><strong>Total à payer :</strong></td>
                <td><strong>{{ total }} DT</strong></td>
            </tr>
        </tbody>
    </table>

    <p style="text-align: center; font-size: 12px; color: #555; margin-top: 20px;">
        <strong>FIRMA</strong> - Tous les droits sont réservés. Conçu par Byteshifters.
    </p>
</main>
{% endblock %}