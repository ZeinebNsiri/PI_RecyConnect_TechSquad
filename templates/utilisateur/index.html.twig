{% extends 'base2.html.twig' %}

{% block title %}Liste des utilisateurs{% endblock %}

{% block body %}
    <style>
    /* Style du switch */
    .switch {
    position: relative;
    display: inline-block;
    width: 50px;
    height: 25px;
    }

    .switch input {
    opacity: 0;
    width: 0;
    height: 0;
    }

    .slider {
    position: absolute;
    cursor: pointer;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: #ccc;
    transition: .4s;
    border-radius: 25px;
    }

    .slider:before {
    position: absolute;
    content: "";
    height: 18px;
    width: 18px;
    left: 4px;
    bottom: 3px;
    background-color: white;
    transition: .4s;
    border-radius: 50%;
    }

    input:checked + .slider {
    background-color: #205719; /* Vert si actif */
    }

    input:checked + .slider:before {
    transform: translateX(24px);
    }
    select option:hover {
    background-color: #205719 !important;
    color: white !important;
    }
                .pagination .page-link {
        color: #138A4B !important;  /* Texte vert */
        background-color: white !important; /* Fond blanc */
        border-color: #138A4B !important; /* Bordure verte */
    }

    .pagination .page-item.active .page-link {
        background-color: #0F6B3D !important; /* Fond vert foncé */
        color: white !important; /* Texte blanc */
        border-color: #0F6B3D !important;
    }

    .pagination .page-link:hover {
        background-color: #A5D6A7 !important; /* Vert clair au survol */
        color: #0F6B3D !important; /* Texte vert foncé */
    }

    .pagination .page-item:first-child .page-link,
    .pagination .page-item:last-child .page-link {
        background-color: #138A4B !important; /* Fond vert pour Précédent et Suivant */
        color: white !important; /* Texte blanc */
        border-color: #138A4B !important;
    }

    .pagination .page-item:first-child .page-link:hover,
    .pagination .page-item:last-child .page-link:hover {
        background-color: #A5D6A7 !important; /* Vert clair au survol */
        color: #0F6B3D !important; /* Texte vert foncé */
    }

    </style>
<main id="main" class="main">
<section class="section dashboard">
        <div class="row">
            <div class="col-12">
                {% for type, messages in app.flashes %}
                        {% for message in messages %}
                            <div class="alert alert-{{ type }} alert-dismissible fade show d-flex justify-content-between align-items-center" role="alert">
                                <span>{{ message }}</span>
                                <span class="close-icon" style="cursor: pointer; margin-left: 10px;" data-bs-dismiss="alert" aria-label="Close">
                                    X
                                </span>

                            </div>
                        {% endfor %}
                    {% endfor %}
                <div class="card top-selling overflow-auto">

                    <div class="card-body pb-0">
                    <a href="{{ path('app_statistiques_utlisateurs') }}" class="btn btn-success">Statistiques des Catégories</a>
                        <div class="row align-items-center d-flex justify-content-between mb-3">
                            <div class="col-auto">
                                <h5 class="card-title mb-0">Liste des utilisateurs</h5>
                            </div>

                            <div class="col-auto">
                                <select id="inputState" class="form-select" onchange="filterUsers(this.value)">
                                    <option value="all">Tous les utilisateurs</option>
                                    <option value="particuliers">Les particuliers</option>
                                    <option value="professionnels">Les professionnels</option>
                                    <option value="true">Les comptes activé</option>
                                    <option value="false">Les comptes désactivé</option>
                                </select>
                            </div>
                        </div>
                        
                        <form id="searchForm">
                        <div class="row">
                            <div class="col-md-3">
                                <input type="text" class="form-control" name="email" placeholder="Email">
                            </div>
                            
                            <div class="col-md-3">
                                <input type="text" class="form-control" name="numTel" placeholder="Numéro de téléphone">
                            </div>
                            <div class="col-md-3">
                                <select class="form-control" name="role">
                                    <option value="">Tous les rôles</option>
                                    <option value="ROLE_USER">Particulier</option>
                                    <option value="ROLE_PROFESSIONNEL">Professionnel</option>
                                </select>
                            </div>
                            
                            <div class="col-md-3">
                                <button type="button" class="btn btn-success" onclick="searchUsers()">Rechercher</button>
                            </div>
                        </div>
                        
                        <div class="row mt-2">
                            
                            
                        </div>
                    </form>
                

                        <table class="table table-borderless" id="userTable">
                            <thead>
                                <tr>
                                    <th scope="col">#</th>
                                    <th scope="col">Nom utilisateur</th>
                                    <th scope="col">Prénom_utilisateur</th>
                                    <th scope="col">Email</th>
                                    <th scope="col">Téléphone</th>
                                    <th scope="col">Role</th>
                                    <th scope="col">Matricule_fiscale</th>
                                    <th scope="col">Etat</th>
                                    <th scope="col"></th>
                                    <th scope="col"></th>
                                    
                                </tr>
                            </thead>
                            <tbody>
                                {% for user in users %}
                                    <tr>
                                        <th scope="row">{{ loop.index }}</th>

                                        <td>{{user.nomUser}}</td>
                                        <td>{{user.prenom}}</td>
                                        <td>{{user.email}}</td>
                                        <td>{{user.numTel}}</td>
                                        {% if 'ROLE_PROFESSIONNEL' in user.roles %}
                                        <td>Professionnel</td>
                                        {% endif %}
                                        {% if 'ROLE_USER' in user.roles %}
                                        <td>Particulier</td>
                                        {% endif %}
                                        <td>{{user.matriculeFiscale}}</td>
                                        
                                       <td>
                                            <label class="switch">
                                                <input type="checkbox" class="toggle-status" 
                                                    data-id="{{ user.id }}" 
                                                    data-status="{{ user.status ? '1' : '0' }}" 
                                                    {{ user.status ? 'checked' : '' }}>
                                                <span class="slider round"></span>
                                            </label>
                                        </td>

                                        
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                        <nav aria-label="Page navigation">
                                <ul class="pagination">
                                    {{ knp_pagination_render(users) }}
                                </ul>
                            </nav>
                    </div>
                </div>
            </div>
        </div>
    </section>
    </main>

    <script>
    function filterUsers(type) {
        fetch('/Liste/utilisateurs/' + type)
            .then(response => response.text())
            .then(data => {
                const parser = new DOMParser();
                const doc = parser.parseFromString(data, 'text/html');
                const newTable = doc.querySelector('#userTable').innerHTML;
                document.querySelector('#userTable').innerHTML = newTable;

                // Réattacher les événements sur les nouveaux boutons switch
                attachToggleEvent();
            })
            .catch(error => console.error('Erreur lors du filtrage :', error));
    }
</script>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    function attachToggleEvent() {
        $(".toggle-status").off('change').on('change', function () {
            var switchButton = $(this);
            var userId = switchButton.data("id");
            var newStatus = switchButton.is(":checked") ? 1 : 0;

            var url = newStatus == 1 
                ? "{{ path('app_Activer', {'id': 'USER_ID'}) }}" 
                : "{{ path('app_Desactiver', {'id': 'USER_ID'}) }}";

            url = url.replace("USER_ID", userId);

            $.ajax({
                url: url,
                type: "GET",
                dataType: "json",
                success: function (response) {
                    if (response.success) {
                        // Recharger la liste des utilisateurs après activation/désactivation
                        filterUsers(document.getElementById("inputState").value);
                    } else {
                        alert("Erreur : " + response.message);
                        switchButton.prop("checked", !newStatus);
                    }
                },
                error: function () {
                    alert("Erreur lors de la mise à jour du statut.");
                    switchButton.prop("checked", !newStatus);
                }
            });
        });
    }

    // Attacher les événements au chargement de la page
    $(document).ready(function () {
        attachToggleEvent();
    });
</script>


<script>
    function searchUsers() {
    let form = document.getElementById('searchForm');
    let formData = new FormData(form);
    let query = new URLSearchParams(formData).toString();

    

    fetch('/Liste/utilisateurs?' + query, {
        method: 'GET',
        headers: {
            'X-Requested-With': 'XMLHttpRequest'
        }
    })
    .then(response => response.text())
    .then(data => {
        const parser = new DOMParser();
        const doc = parser.parseFromString(data, 'text/html');
        document.querySelector('#userTable tbody').innerHTML = doc.querySelector('#userTable tbody').innerHTML;
    })
    .catch(error => console.error('Erreur lors du filtrage :', error));
}

</script>

    
{% endblock %}
