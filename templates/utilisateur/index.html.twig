{% extends 'base2.html.twig' %}

{% block title %}Liste des utilisateurs{% endblock %}

{% block body %}
    <style>
    /* Style du switch */
    .switch {
    position: relative;
    display: inline-block;
    width: 50px;
    height: 25px;
    }

    .switch input {
    opacity: 0;
    width: 0;
    height: 0;
    }

    .slider {
    position: absolute;
    cursor: pointer;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: #ccc;
    transition: .4s;
    border-radius: 25px;
    }

    .slider:before {
    position: absolute;
    content: "";
    height: 18px;
    width: 18px;
    left: 4px;
    bottom: 3px;
    background-color: white;
    transition: .4s;
    border-radius: 50%;
    }

    input:checked + .slider {
    background-color: #205719; /* Vert si actif */
    }

    input:checked + .slider:before {
    transform: translateX(24px);
    }
    </style>
<main id="main" class="main">
<section class="section dashboard">
        <div class="row">
            <div class="col-12">
                {% for type, messages in app.flashes %}
                        {% for message in messages %}
                            <div class="alert alert-{{ type }} alert-dismissible fade show d-flex justify-content-between align-items-center" role="alert">
                                <span>{{ message }}</span>
                                <span class="close-icon" style="cursor: pointer; margin-left: 10px;" data-bs-dismiss="alert" aria-label="Close">
                                    X
                                </span>

                            </div>
                        {% endfor %}
                    {% endfor %}
                <div class="card top-selling overflow-auto">

                    <div class="card-body pb-0">
                        <h5 class="card-title">Liste des utilisateurs</h5>
                        <div class="col-md-2">
                  
                <select id="inputState" class="form-select" onchange="filterUsers(this.value)">
                    <option value="all">Tous les utilisateurs</option>
                    <option value="particuliers">Les particuliers</option>
                    <option value="professionnels">Les professionnels</option>
                    <option value="true">Les comptes activé</option>
                    <option value="false">Les comptes désactivé</option>
                </select>


                </div>

                        <table class="table table-borderless" id="userTable">
                            <thead>
                                <tr>
                                    <th scope="col">#</th>
                                    <th scope="col">Nom utilisateur</th>
                                    <th scope="col">Prénom_utilisateur</th>
                                    <th scope="col">Email</th>
                                    <th scope="col">Role</th>
                                    <th scope="col">Matricule_fiscale</th>
                                    <th scope="col">Etat</th>
                                    <th scope="col"></th>
                                    <th scope="col"></th>
                                    
                                </tr>
                            </thead>
                            <tbody>
                                {% for user in users %}
                                    <tr>
                                        <th scope="row">{{ loop.index }}</th>

                                        <td>{{user.nomUser}}</td>
                                        <td>{{user.prenom}}</td>
                                        <td>{{user.email}}</td>
                                        {% if 'ROLE_PROFESSIONNEL' in user.roles %}
                                        <td>Professionnel</td>
                                        {% endif %}
                                        {% if 'ROLE_USER' in user.roles %}
                                        <td>Particulier</td>
                                        {% endif %}
                                        <td>{{user.matriculeFiscale}}</td>
                                        
                                       <td>
                                            <label class="switch">
                                                <input type="checkbox" class="toggle-status" 
                                                    data-id="{{ user.id }}" 
                                                    data-status="{{ user.status ? '1' : '0' }}" 
                                                    {{ user.status ? 'checked' : '' }}>
                                                <span class="slider round"></span>
                                            </label>
                                        </td>

                                        
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </section>
    </main>

    <script>
    function filterUsers(type) {
        fetch('/Liste/utilisateurs/' + type)
            .then(response => response.text())
            .then(data => {
                const parser = new DOMParser();
                const doc = parser.parseFromString(data, 'text/html');
                const newTable = doc.querySelector('#userTable').innerHTML;
                document.querySelector('#userTable').innerHTML = newTable;

                // Réattacher les événements sur les nouveaux boutons switch
                attachToggleEvent();
            })
            .catch(error => console.error('Erreur lors du filtrage :', error));
    }
</script>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    function attachToggleEvent() {
        $(".toggle-status").off('change').on('change', function () {
            var switchButton = $(this);
            var userId = switchButton.data("id");
            var newStatus = switchButton.is(":checked") ? 1 : 0;

            var url = newStatus == 1 
                ? "{{ path('app_Activer', {'id': 'USER_ID'}) }}" 
                : "{{ path('app_Desactiver', {'id': 'USER_ID'}) }}";

            url = url.replace("USER_ID", userId);

            $.ajax({
                url: url,
                type: "GET",
                dataType: "json",
                success: function (response) {
                    if (response.success) {
                        // Recharger la liste des utilisateurs après activation/désactivation
                        filterUsers(document.getElementById("inputState").value);
                    } else {
                        alert("Erreur : " + response.message);
                        switchButton.prop("checked", !newStatus);
                    }
                },
                error: function () {
                    alert("Erreur lors de la mise à jour du statut.");
                    switchButton.prop("checked", !newStatus);
                }
            });
        });
    }

    // Attacher les événements au chargement de la page
    $(document).ready(function () {
        attachToggleEvent();
    });
</script>




    
{% endblock %}
