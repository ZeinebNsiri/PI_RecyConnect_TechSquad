<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Réinitialisation du mot de passe</title>

    <!-- Fichiers CSS -->
    <link rel="stylesheet" href="{{ asset('login_signup/css/style.css') }}">
    <link rel="stylesheet" href="{{ asset('login_signup/vendors/css/vendor.bundle.base.css') }}">
    <link rel="shortcut icon" href="{{ asset('frontOffice/img/mainlogo.png') }}" />
    <link rel="stylesheet" href="{{ asset('login_signup/vendors/mdi/css/materialdesignicons.min.css') }}">
</head>
<body>

    <div class="container-scroller">
        <div class="container-fluid page-body-wrapper full-page-wrapper">
            <div class="row w-100 m-0">
                <div class="content-wrapper full-page-wrapper d-flex align-items-center auth login-bg">
                    <div class="card col-lg-4 mx-auto">
                        <div class="card-body px-5 py-5">
                            <h3 class="card-title text-left mb-3">Réinitialiser votre mot de passe</h3>

                            {{ form_start(resetForm,{attr:{novalidate:'novalidate'}}) }}
                                <div class="form-group">
                                    <label for="plainPassword_first">Nouveau mot de passe</label>
                                    {{ form_widget(resetForm.plainPassword.first, { 'attr': {'class': 'form-control p_input', 'placeholder': 'Saisissez un nouveau mot de passe'} }) }}
                                </div>
                                <div class="form-group">
                                    <label for="plainPassword_second">Confirmez le mot de passe</label>
                                    {{ form_widget(resetForm.plainPassword.second, { 'attr': {'class': 'form-control p_input', 'placeholder': 'Confirmez votre mot de passe'} }) }}
                                </div>
                                <div class="text-danger">
                                    {{ form_errors(resetForm.plainPassword.first) }}
                                </div>

                                
                                <div class="form-group">
                                    <button type="submit" class="btn btn-primary btn-block enter-btn">Réinitialiser le mot de passe</button>
                                </div>
                            {{ form_end(resetForm) }}

                            <p class="sign-up text-center mt-3" style="color: #205719;">
                                Retourner à la <a href="{{ path('app_login') }}">page de connexion</a>.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts JavaScript -->
    <script src="{{ asset('login_signup/vendors/js/vendor.bundle.base.js') }}"></script>
    <script src="{{ asset('login_signup/js/misc.js') }}"></script>

</body>
</html>
