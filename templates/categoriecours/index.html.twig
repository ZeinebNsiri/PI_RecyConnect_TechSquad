{% extends 'base2.html.twig' %}

{% block title %} Liste des Catégories {% endblock %}

{% block body %}
<main id="main" class="main">
{% for message in app.session.flashBag.get('success') %}
    <div class="alert alert-success alert-dismissible fade show d-flex justify-content-between align-items-center" role="alert">
        {{ message }}
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
{% endfor %}
<style>
        .pagination .page-link {
        color: #138A4B !important;  /* Texte vert */
        background-color: white !important; /* Fond blanc */
        border-color: #138A4B !important; /* Bordure verte */
    }

    .pagination .page-item.active .page-link {
        background-color: #0F6B3D !important; /* Fond vert foncé */
        color: white !important; /* Texte blanc */
        border-color: #0F6B3D !important;
    }

    .pagination .page-link:hover {
        background-color: #A5D6A7 !important; /* Vert clair au survol */
        color: #0F6B3D !important; /* Texte vert foncé */
    }

    .pagination .page-item:first-child .page-link,
    .pagination .page-item:last-child .page-link {
        background-color: #138A4B !important; /* Fond vert pour Précédent et Suivant */
        color: white !important; /* Texte blanc */
        border-color: #138A4B !important;
    }

    .pagination .page-item:first-child .page-link:hover,
    .pagination .page-item:last-child .page-link:hover {
        background-color: #A5D6A7 !important; /* Vert clair au survol */
        color: #0F6B3D !important; /* Texte vert foncé */
    }

    
</style>

  <div class="card">
      <div class="card-body">
          <h5 class="card-title">Liste des Catégories</h5>

         <a href="{{ path('categorie_cours_add') }}" class="btn btn-success">+ Ajouter catégorie</a><br><br>



          <!-- Table avec des lignes survolables -->
          <table class="table table-hover">
              <thead>
                  <tr>
                      <th scope="col">#</th>
                      <th scope="col">Nom de la Catégorie</th>
                      <th scope="col">Description</th>
                      <th scope="col">Details</th>
                  </tr>
              </thead>
              <tbody>
                  {% for categorie in categories %}
                      <tr>
                          <th scope="row">{{ loop.index }}</th>
                          <td>{{ categorie.nomCategorie }}</td>
                          <td style="white-space: normal; word-wrap: break-word; max-width: 400px;">{{ categorie.descriptionCategorie }}</td>
                          <td>
                           <a href="{{ path('app_editcategoriecours', {'id': categorie.id}) }}" class="btn btn-success"><i class="bi bi-pencil-square"></i> Modifier</a>

                           <a  class="btn btn-danger delete-btn"data-url="{{ path('app_deletecategoriecours', {'id': categorie.id}) }}"data-entity="CategorieCours"data-genre="f"><i class="bi bi-trash"></i> Supprimer</a>
                           
                    
                          </td>
                      </tr>
                  {% else %}
                      <tr>
                          <td colspan="3" class="text-center">Aucune catégorie trouvée</td>
                      </tr>
                  {% endfor %}
              </tbody>
          </table>
          <!-- Fin de la Table -->

           <nav aria-label="Page navigation">
                                <ul class="pagination">
                                    {{ knp_pagination_render(categories) }}
                                </ul>
                            </nav>
           
      </div>
  </div>
  </main>
{% endblock %}
