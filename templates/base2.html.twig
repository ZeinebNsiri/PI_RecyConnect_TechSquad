     <script>
            function loadNotifications() {
                $.ajax({
                    url: "{{ path('app_notifications') }}",
                    type: "GET",
                    dataType: "json",
                    success: function (data) {
                        let notificationList = $("#notification-list");
                        let notificationCount = $("#notification-count");
                        notificationList.find(".notification-item").remove();
                        
                        if (data.length > 0) {
                            $("#notification-title").text(`Vous avez ${data.length} nouvelles notifications`);
                            notificationCount.text(data.length);

                            data.forEach(notification => {
                                let notifItem = `
                                    <li class="notification-item">
                                        <i class="bi bi-info-circle text-success"></i>
                                        <div>
                                            <h4>${notification.message}</h4>
                                            <p>${notification.createdAt}</p>
                                        </div>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                `;
                                notificationList.append(notifItem);
                            });
                        } else {
                            $("#notification-title").text("Aucune nouvelle notification");
                            notificationCount.text(0);
                        }
                    },
                    error: function () {
                        $("#notification-title").text("Erreur de chargement");
                    }
                });
            }

            function markNotificationsAsRead() {
                $.ajax({
                    url: "{{ path('app_notifications_mark_as_read') }}",
                    type: "POST",
                    dataType: "json",
                    success: function (response) {
                        if (response.success) {
                            $("#notification-count").text(0); // Réinitialise le compteur après fermeture
                        }
                    },
                    error: function () {
                        console.error("Erreur lors de la mise à jour des notifications.");
                    }
                });
            }

            $(document).ready(function () {
                loadNotifications();

                // Détecter la fermeture du dropdown et marquer les notifications comme lues
                $(".nav-item.dropdown").on("hidden.bs.dropdown", function () {
                    markNotificationsAsRead();
                    loadNotifications(); // Recharger la liste après fermeture
                });
            });
     </script>



        <!-- Confirmation de suppression avec SweetAlert -->


        <script>
            document.addEventListener("DOMContentLoaded", function () {
                document.querySelectorAll(".delete-btn").forEach(button => {
                    button.addEventListener("click", function (event) {
                        event.preventDefault();

                        const deleteUrl = this.getAttribute("data-url");
                        const entity = this.getAttribute("data-entity") || "élément";
                        const genre = this.getAttribute("data-genre") || "m"; // Par défaut masculin

                        // Accord du texte selon le genre
                        const article = (genre === "f") ? "cette" : "ce";
                        const supprimé = (genre === "f") ? "supprimée" : "supprimé";
                        const erreur = (genre === "f") ? "une erreur s'est produite lors de la suppression de la" : "une erreur s'est produite lors de la suppression du";

                        Swal.fire({
                            title: "Êtes-vous sûr ?",
                            text: `Vous ne pourrez pas revenir en arrière !`,
                            icon: "warning",
                            showCancelButton: true,
                            confirmButtonColor: "#198754",
                            cancelButtonColor: "#d33",
                            confirmButtonText: "Oui, supprimer !",
                            cancelButtonText: "Annuler"
                        }).then((result) => {
                            if (result.isConfirmed) {
                                fetch(deleteUrl, { method: 'GET' })
                                .then(response => {
                                    if (response.ok) {
                                        Swal.fire({
                                            title: "Supprimé !",
                                            text: `${article.charAt(0).toUpperCase() + article.slice(1)} ${entity} a été ${supprimé} avec succès.`,
                                            icon: "success"
                                        }).then(() => {
                                            location.reload();
                                        });
                                    } else {
                                        Swal.fire({
                                            title: "Erreur",
                                            text: `${erreur} ${entity}.`,
                                            icon: "error"
                                        });
                                    }
                                })
                                .catch(error => {
                                    Swal.fire({
                                        title: "Erreur",
                                        text: `Une erreur inattendue s'est produite lors de la suppression de ${article} ${entity}.`,
                                        icon: "error"
                                    });
                                });
                            }
                        });
                    });
                });
            });
        </script>




