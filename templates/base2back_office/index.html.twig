{# templates/base2back_office/index.html.twig #}
{% extends 'base2.html.twig' %}

{% block title %}
    Dashboard 
{% endblock %}

{% block body %}
<main id="main" class="main">

    <!-- Page Title / Breadcrumb -->
    <div class="pagetitle">
        <h1>Dashboard</h1>
        <nav>
            <ol class="breadcrumb">
                <li class="breadcrumb-item">
                    <a href="{{ path('home') }}">Home</a>
                </li>
                <li class="breadcrumb-item active">Dashboard</li>
            </ol>
        </nav>
    </div>
    <!-- End Page Title -->

    <section class="section dashboard">
        <div class="row">

            {# ---------------------------------------------------------- #}
            {#                 1) Statistiques Articles                  #}
            {# ---------------------------------------------------------- #}
            <div class="card mb-4">
                <div class="card-body">
                    <h2 class="card-title">Statistiques des Articles</h2>
                    
                    <!-- Répartition des Articles par Catégorie -->
                    <h5>Répartition des Articles par Catégorie</h5>
                    <div class="chart-container mb-4"
                         style="width: 100%; max-width: 800px; height: 350px; margin: 0 auto;">
                        <canvas id="categoryChart"></canvas>
                    </div>
                    
                    <hr> {# A small horizontal separator #}

                    <!-- Quantité des Articles -->
                    <h5>Quantité des Articles</h5>
                    <div class="chart-container"
                         style="width: 100%; max-width: 800px; height: 300px; margin: 0 auto;">
                        <canvas id="articleChart"></canvas>
                    </div>
                </div>
            </div>

            <hr class="my-4"> {# Optional separator between major sections #}

            {# ---------------------------------------------------------- #}
            {#           2) Dashboard Cours / Workshops (ApexCharts)     #}
            {# ---------------------------------------------------------- #}
            <div class="card mb-4">
                <div class="card-body">
                    <h2 class="card-title">Statistiques des Workshops</h2>
                    
                    <!-- 1) Nombre du workshop par catégorie -->
                    <h5>Nombre du workshop par catégorie</h5>
                    <div id="chartCategory" style="width: 100%; height: 400px;"></div>
                    
                    <hr>

                    <!-- 2) Répartition du total des notes par catégorie -->
                    <h5>Répartition du total des notes par catégorie</h5>
                    <div id="pieChartByCategory" style="width: 100%; height: 400px;"></div>
                    
                    <hr>

                    <!-- 3) Moyenne de notes par Workshop -->
                    <h5>Moyenne de notes par Workshop</h5>
                    <div id="polarChartAverage" style="width: 100%; height: 400px;"></div>
                </div>
            </div>

            <hr class="my-4">

            {# ---------------------------------------------------------- #}
            {#                 3) Statistiques Ventes (Sales)            #}
            {# ---------------------------------------------------------- #}
            <div class="card mb-4">
                <div class="card-body">
                    <h2 class="card-title">Statistiques Ventes</h2>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="info-card sales-card mb-4">
                                <h5 class="mb-1">Total des ventes - Aujourd'hui</h5>
                                <div>
                                    <strong>{{ todayOrdersTotal }}</strong> TND
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="info-card sales-card mb-4">
                                <h5 class="mb-1">Ventes Payées (Commandes payées)</h5>
                                <div>
                                    <strong>{{ paidOrdersCount }}</strong>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <hr class="my-4">

            {# ---------------------------------------------------------- #}
            {#                 4) Statistiques des Événements            #}
            {# ---------------------------------------------------------- #}
            <div class="card mb-4">
                <div class="card-body">
                    <h2 class="card-title">Statistiques des Événements</h2>

                    <!-- (a) Événements les plus réservés (Doughnut) -->
                    <h5>Les événements ayant le plus grand nombre de réservations</h5>
                    <div style="position: relative; height: 300px; width: 100%;">
                        <canvas id="popularEventsChart"></canvas>
                    </div>

                    <div class="mt-3">
                        <h5>Détails des Réservations</h5>
                        <div class="row">
                            {% for event in popularEvents %}
                                <div class="col-md-6 mb-2">
                                    <div class="card border-0 shadow-sm h-100">
                                        <div class="card-body p-2">
                                            <h5 class="card-title fw-bold fs-6">{{ event.nomEvent }}</h5>
                                            <p class="card-text text-muted mb-1">
                                                <strong>Réservations:</strong> {{ event.total_reservations|round(0, 'floor') }}
                                            </p>
                                            <p class="card-text text-muted mb-1">
                                                <strong>Date:</strong> {{ event.dateEvent|date('d/m/Y') }}
                                            </p>
                                            <p class="card-text text-muted mb-1">
                                                <strong>Lieu:</strong> {{ event.lieuEvent }}
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>

                    <hr>

                    <!-- (b) Taux d'utilisation de la capacité (Bar) -->
                    <h5>Taux d'utilisation de la capacité</h5>
                    <div style="position: relative; height: 300px; width: 100%;">
                        <canvas id="capacityUtilizationChart"></canvas>
                    </div>
                </div>
            </div>

            <hr class="my-4">

            {# ---------------------------------------------------------- #}
            {#                 5) Statistiques Utilisateurs              #}
            {# ---------------------------------------------------------- #}
            <div class="card mb-4">
                <div class="card-body">
                    <h2 class="card-title">Statistiques des Utilisateurs</h2>
                    <div class="row">
                        <div class="col-lg-6 mb-4">
                            <h5 class="chart-title">Répartition des Rôles</h5>
                            <div style="height: 400px;">
                                <canvas id="rolesChart"></canvas>
                            </div>
                        </div>
                        <div class="col-lg-6 mb-4">
                            <h5 class="chart-title">Statut des Comptes</h5>
                            <div style="height: 400px;">
                                <canvas id="statusChart"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div><!-- End row -->
    </section>

</main>

{# ---------------------------------------------------------------------- #}
{#  Include scripts for Chart.js and ApexCharts once at the bottom         #}
{# ---------------------------------------------------------------------- #}
<!-- Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<!-- ApexCharts -->
<script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>

<script>
/**
 * ============================================================================
 *                    1) Charts for Articles Stats (Chart.js)
 * ============================================================================
 */
let categoryCtx = document.getElementById('categoryChart').getContext('2d');
let articleCtx  = document.getElementById('articleChart').getContext('2d');

let categoryData   = {{ categoryData|raw }};
let categoryLabels = categoryData.map(c => c.nom);
let categoryValues = categoryData.map(c => c.count);

new Chart(categoryCtx, {
    type: 'polarArea',
    data: {
        labels: categoryLabels,
        datasets: [{
            label: "Nombre d'articles",
            data: categoryValues,
            backgroundColor: [
                'rgba(255, 99, 132, 0.5)',
                'rgba(54, 162, 235, 0.5)',
                'rgba(255, 206, 86, 0.5)',
                'rgba(75, 192, 192, 0.5)',
                'rgba(153, 102, 255, 0.5)',
                'rgba(255, 159, 64, 0.5)'
            ],
            borderWidth: 1
        }]
    },
    options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
            legend: { position: 'right' }
        }
    }
});

let articleData   = {{ articleData|raw }};
let articleLabels = articleData.map(a => a.nom);
let articleValues = articleData.map(a => a.quantite);

// Generate random colors for article bars
function generateRandomColors(n) {
    let colors = [];
    for (let i = 0; i < n; i++) {
        let color = `rgba(${Math.floor(Math.random() * 255)}, 
                          ${Math.floor(Math.random() * 255)}, 
                          ${Math.floor(Math.random() * 255)}, 0.6)`;
        colors.push(color);
    }
    return colors;
}
let articleColors = generateRandomColors(articleData.length);

new Chart(articleCtx, {
    type: 'bar',
    data: {
        labels: articleLabels,
        datasets: [{
            label: "Quantité (KG)",
            data: articleValues,
            backgroundColor: articleColors,
            borderColor: articleColors.map(color => color.replace('0.6', '1')),
            borderWidth: 1
        }]
    },
    options: {
        indexAxis: 'y',
        responsive: true,
        maintainAspectRatio: false,
        scales: {
            x: {
                beginAtZero: true
            }
        },
        plugins: {
            legend: { display: false }
        }
    }
});


/**
 * ============================================================================
 *            2) Dashboard Cours / Workshops (ApexCharts)
 * ============================================================================
 */
const statsCategory = {{ statsCategory|json_encode()|raw }};
// Tri décroissant par total
statsCategory.sort((a, b) => b.total - a.total);
const catNames  = statsCategory.map(item => item.category || 'SansCat');
const catTotals = statsCategory.map(item => item.total);

const statsRatingSumByCategory = {{ statsRatingSumByCategory|json_encode()|raw }};
const pieLabels = statsRatingSumByCategory.map(i => i.category);
const pieSeries = statsRatingSumByCategory.map(i => parseFloat(i.ratingSum));

const averageByWorkshop = {{ averageByWorkshop|json_encode()|raw }};
// Tri décroissant par moyenne
averageByWorkshop.sort((a, b) => b.averageRating - a.averageRating);
const polarLabels = averageByWorkshop.map(i => i.workshop);
const polarSeries = averageByWorkshop.map(i => parseFloat(i.averageRating));

// 2-A) Nombre de workshop par catégorie (Bar)
var optionsCategory = {
    series: [{
        name: 'Cours',
        data: catTotals
    }],
    chart: {
        type: 'bar',
        height: 400
    },
    xaxis: {
        categories: catNames
    },
    yaxis: {
        labels: {
            formatter: function(val) {
                return parseInt(val);
            }
        },
        forceNiceScale: true,
        tickAmount: 5,
        min: 0
    }
};
var chartCategory = new ApexCharts(document.querySelector("#chartCategory"), optionsCategory);
chartCategory.render();

// 2-B) Répartition du total des notes par catégorie (Pie)
var optionsPie = {
    series: pieSeries,
    chart: {
        type: 'pie',
        height: 350
    },
    labels: pieLabels,
    legend: {
        position: 'bottom'
    }
};
var chartPie = new ApexCharts(document.querySelector("#pieChartByCategory"), optionsPie);
chartPie.render();

// 2-C) Moyenne de notes par Workshop (Polar Area)
var optionsPolar = {
    series: polarSeries,
    chart: {
        type: 'polarArea',
        height: 350
    },
    labels: polarLabels,
    fill: { opacity: 1 },
    stroke: { width: 1 },
    legend: { position: 'bottom' },
    yaxis: { show: false },
    plotOptions: {
        polarArea: {
            rings: { strokeWidth: 0 },
            spokes: { strokeWidth: 0 }
        }
    }
};
var chartPolar = new ApexCharts(document.querySelector("#polarChartAverage"), optionsPolar);
chartPolar.render();


/**
 * ============================================================================
 *             4) Statistiques des Événements (Chart.js)
 * ============================================================================
 */
var ctxPopular = document.getElementById('popularEventsChart').getContext('2d');
var popularEvents = {{ popularEvents|json_encode()|raw }};
var popularLabels = popularEvents.map(e => e.nomEvent);
var popularData   = popularEvents.map(e => parseFloat(e.total_reservations || 0));

new Chart(ctxPopular, {
    type: 'doughnut',
    data: {
        labels: popularLabels,
        datasets: [{
            label: 'Nombre de Réservations',
            data: popularData,
            backgroundColor: [
                'rgba(75, 192, 192, 0.7)',
                'rgba(54, 162, 235, 0.7)',
                'rgba(255, 99, 132, 0.7)',
                'rgba(255, 206, 86, 0.7)',
                'rgba(153, 102, 255, 0.7)',
                'rgba(255, 159, 64, 0.7)'
            ],
            borderColor: 'rgba(255, 255, 255, 1)',
            borderWidth: 2,
            hoverBackgroundColor: 'rgba(0, 0, 0, 0.9)'
        }]
    },
    options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
            legend: {
                display: true,
                position: 'bottom',
            },
            tooltip: {
                enabled: true,
                backgroundColor: 'rgba(0,0,0,0.7)'
            }
        }
    }
});

// Capacity Utilization
var ctxCapacity = document.getElementById('capacityUtilizationChart').getContext('2d');
var capacityUtilization = {{ capacityUtilization|json_encode()|raw }};
var capacityLabels = capacityUtilization.map(e => e.event_name);
var capacityValues = capacityUtilization.map(e => {
    let rate = (e.total_reservations / e.capacity) * 100;
    return rate ? parseFloat(rate.toFixed(2)) : 0;
});

new Chart(ctxCapacity, {
    type: 'bar',
    data: {
        labels: capacityLabels,
        datasets: [{
            label: "Taux d'utilisation (%)",
            data: capacityValues,
            backgroundColor: 'rgba(75, 192, 192, 0.7)',
            borderColor: 'rgba(75, 192, 192, 1)',
            borderWidth: 2
        }]
    },
    options: {
        responsive: true,
        maintainAspectRatio: false,
        scales: {
            y: {
                beginAtZero: true,
                max: 100
            }
        },
        plugins: {
            legend: { display: true, position: 'top' },
            tooltip: { enabled: true, backgroundColor: 'rgba(0,0,0,0.7)' }
        }
    }
});


/**
 * ============================================================================
 *             5) Statistiques des Utilisateurs (Chart.js)
 * ============================================================================
 */
let userStats = {{ userStats|json_encode()|raw }};

let rolesCtx  = document.getElementById('rolesChart').getContext('2d');
let statusCtx = document.getElementById('statusChart').getContext('2d');

// Rôles (Professionnels vs Particuliers)
new Chart(rolesCtx, {
    type: 'doughnut',
    data: {
        labels: ["Professionnels", "Particuliers"],
        datasets: [{
            data: [
                userStats.roles.Professionnels || 0,
                userStats.roles.Particuliers || 0
            ],
            backgroundColor: [
                'rgba(54, 162, 235, 0.8)',   // Bleu
                'rgba(255, 206, 86, 0.8)'    // Jaune
            ],
            hoverOffset: 4
        }]
    },
    options: {
        responsive: true,
        cutout: '60%',
        plugins: {
            legend: { position: 'top' }
        }
    }
});

// Statuts (Activés vs Désactivés)
new Chart(statusCtx, {
    type: 'doughnut',
    data: {
        labels: ["Activés", "Désactivés"],
        datasets: [{
            data: [
                userStats.status.Activés || 0,
                userStats.status.Désactivés || 0
            ],
            backgroundColor: [
                'rgba(40, 167, 69, 0.8)',    // Vert foncé
                'rgba(144, 238, 144, 0.8)'   // Vert clair
            ],
            hoverOffset: 4
        }]
    },
    options: {
        responsive: true,
        cutout: '60%',
        plugins: {
            legend: { position: 'top' }
        }
    }
});
</script>

{% endblock %}
