{% extends 'base2.html.twig' %}

{% block title %}Toutes les Notifications{% endblock %}

{% block body %}
<main id="main" class="main">
    <section class="section dashboard">
        <div class="row">
        <div class="container mt-4">
            <h2 class="mb-4 text-center">📢 Centre de Notifications</h2>

            {% if notifications is empty %}
                <div class="alert alert-info text-center">Aucune notification disponible.</div>
            {% else %}
                <div class="row">
                    {% for notification in notifications %}
                        <div class="col-md-6 col-lg-4 mb-4">
                            <div class="card shadow-sm p-3 border {% if not notification.isRead %}border-warning{% endif %}">
                                <div class="d-flex align-items-center">
                                    {% if notification.isRead %}
                                        <i class="bi bi-check-circle text-success fs-3 me-3"></i>
                                    {% else %}
                                        <i class="bi bi-bell-fill text-warning fs-3 me-3"></i>
                                    {% endif %}
                                    <div>
                                        <h5 class="mb-1">{{ notification.message }}</h5>
                                        <small class="text-muted">{{ notification.createdAt|date('d/m/Y H:i') }}</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}

            
        </div>
        </div>
    </section>
</main>
{% endblock %}
