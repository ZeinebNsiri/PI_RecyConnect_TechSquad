{% extends 'basecnx.html.twig' %}

{% block title %}Mes Réservations{% endblock %}

{% block body %}
    <!-- Page Header Start -->
    <div class="container-fluid page-header py-5 mb-5 wow fadeIn" data-wow-delay="0.1s">
        <div class="container text-center py-5">
            <h1 class="display-3 text-white mb-4 animated slideInDown">Mes réservations</h1>
            <nav aria-label="breadcrumb animated slideInDown">
                <ol class="breadcrumb justify-content-center mb-0">
                    <li class="breadcrumb-item"><a href="{{ path('events_list') }}">Accueil</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Réservation</li>
                </ol>
            </nav>
        </div>
    </div>
    <!-- Page Header End -->

    <section id="reservations" class="reservations section">
        <div class="container" data-aos="fade-up">

            <!-- Filter Dropdown -->
            <div class="mb-4 text-end">
                <select id="filter-status" class="form-select form-select-sm" style="width: auto;">
                    <option value="">Toutes les réservations</option>
                    <option value="active">Active</option>
                    <option value="canceled">Canceled</option>
                    <option value="passed">Passed</option>
                    <option value="upcoming">Upcoming</option>
                </select>
            </div>

            <!-- Reservations List -->
            <div id="reservations-list">
                {% if reservations is empty %}
                    <p class="text-center text-muted">Aucune réservation trouvée.</p>
                {% else %}
                    <div class="row">
                        {% for reservation in reservations %}
                            <div class="col-md-6 mb-4 reservation-item" 
                                 data-status="{{ reservation.status }}" 
                                 data-event-date="{{ reservation.getEventId().getDateEvent()|date('Y-m-d') }}">
                                <div class="card reservation-card shadow-lg hover-effect">
                                    <div class="card-body">
                                        <!-- Event Information -->
                                        <div class="event-info mb-4">
                                            <h5 class="card-title mb-3">
                                                <i class="fas fa-calendar-alt me-2"></i>{{ reservation.getEventId().getNomEvent() }}
                                            </h5>
                                            <p class="card-text text-muted">
                                                <i class="fas fa-clock me-2"></i><strong>Date:</strong> {{ reservation.getEventId().getDateEvent()|date('d/m/Y') }} à {{ reservation.getEventId().getHeureEvent()|date('H:i') }}<br>
                                                <i class="fas fa-map-marker-alt me-2"></i><strong>Lieu:</strong> {{ reservation.getEventId().getLieuEvent() }}<br>
                                                <i class="fas fa-user me-2"></i>Réservation pour {{ reservation.getNom() }}
                                            </p>
                                        </div>

                                        <!-- Reservation Information -->
                                        <div class="reservation-info mb-4">
                                            <p class="card-text">
                                                <strong>Places réservées:</strong> <span class="badge bg-primary">{{ reservation.getNbPlaces() }} place(s)</span>
                                            </p>
                                            <p class="card-text">
                                                <strong>Statut:</strong> <span class="badge bg-{{ reservation.status == 'active' ? 'success' : (reservation.status == 'canceled' ? 'danger' : 'secondary') }}">
                                                    {{ reservation.status }}
                                                </span>
                                            </p>
                                        </div>

                                        <!-- Actions -->
                                        <div class="d-flex justify-content-end">
                                            {% if reservation.getEventId().getDateEvent() >= now|date('Y-m-d') and reservation.status == 'active' %}
                                                <a href="{{ path('reservation_edit', {'id': reservation.id}) }}" class="btn btn-outline-primary btn-sm me-2">
                                                    <i class="fas fa-edit"></i> Modifier
                                                </a>
                                                <a href="{{ path('reservation_cancel_confirm', {'id': reservation.id}) }}" class="btn btn-outline-danger btn-sm">
                                                    <i class="fas fa-times"></i> Annuler
                                                </a>
                                            {% elseif reservation.getEventId().getDateEvent() < now|date('Y-m-d') %}
                                                <span class="text-muted">Cet événement est passé.</span>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
        </div>
    </section>

    <!-- JavaScript for Filtering -->
    <script>
        document.getElementById('filter-status').addEventListener('change', function () {
            const selectedStatus = this.value;
            const now = new Date().toISOString().split('T')[0]; // Current date in YYYY-MM-DD format
            const reservationItems = document.querySelectorAll('.reservation-item');

            reservationItems.forEach(item => {
                const status = item.getAttribute('data-status');
                const eventDate = item.getAttribute('data-event-date');

                let shouldShow = true;

                if (selectedStatus === 'active' && status !== 'active') {
                    shouldShow = false;
                } else if (selectedStatus === 'canceled' && status !== 'canceled') {
                    shouldShow = false;
                } else if (selectedStatus === 'passed' && eventDate >= now) {
                    shouldShow = false;
                } else if (selectedStatus === 'upcoming' && eventDate < now) {
                    shouldShow = false;
                }

                item.style.display = shouldShow ? 'block' : 'none';
            });
        });
    </script>
{% endblock %}