{% extends 'basecnx.html.twig' %}

{% block title %}Mes Réservations{% endblock %}

{% block body %}
    <!-- Page Header Start -->
    <div class="container-fluid page-header py-5 mb-5 wow fadeIn" data-wow-delay="0.1s">
        <div class="container text-center py-5">
            <h1 class="display-3 text-white mb-4 animated slideInDown">Mes réservations</h1>
            <nav aria-label="breadcrumb animated slideInDown">
                <ol class="breadcrumb justify-content-center mb-0">
                    <li class="breadcrumb-item"><a href="{{ path('events_list') }}" class="text-white">Accueil</a></li>
                    <li class="breadcrumb-item text-white active" aria-current="page">Réservation</li>
                </ol>
            </nav>
        </div>
    </div>
    <!-- Page Header End -->

    <!-- Reservations Section Start -->
    <div class="container-xxl py-5">
        <div class="container">
            <!-- Search Form -->
            <div class="bg-light rounded p-4 p-sm-5 wow fadeInUp" data-wow-delay="0.1s">
                <h2 class="mb-4">Rechercher une Réservation</h2>
                <form action="{{ path('reservations_list') }}" method="get" class="row g-3">
                    <div class="col-md-6">
                        <input type="text" name="eventName" class="form-control form-control-lg" placeholder="Nom de l'événement" value="{{ eventName }}">
                    </div>
                    <div class="col-md-4">
                        <select name="status" class="form-select form-select-lg">
                            <option value="">Tous les statuts</option>
                            <option value="active" {{ status == 'active' ? 'selected' : '' }}>Active</option>
                            <option value="canceled" {{ status == 'canceled' ? 'selected' : '' }}>Annulée</option>
                            <option value="upcoming" {{ status == 'upcoming' ? 'selected' : '' }}>À venir</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary btn-lg w-100">Rechercher</button>
                    </div>
                </form>
            </div>

            <!-- Reservations List -->
            <div class="mt-5">
                {% if reservations is empty %}
                    <p class="text-center text-muted">Aucune réservation trouvée.</p>
                {% else %}
                    <div class="row g-4">
                        {% for reservation in reservations %}
                            <div class="col-lg-6 col-md-12 wow fadeInUp" data-wow-delay="0.1s">
                                <div class="card border-0 shadow-lg h-100 hover-effect">
                                    <div class="card-body p-4">
                                        <!-- Clickable Event Name -->
                                        <h5 class="card-title fw-bold mb-3">
                                            <a href="{{ path('reservation_show', {'id': reservation.id}) }}" class="text-decoration-none text-dark">
                                                <i class="fas fa-calendar-alt me-2"></i>{{ reservation.getEventId.nomEvent }}
                                            </a>
                                        </h5>

                                        <!-- Event Details -->
                                        <p class="card-text text-muted">
                                            <i class="fas fa-clock me-2"></i><strong>Date:</strong> {{ reservation.getEventId.dateEvent|date('d/m/Y') }} à {{ reservation.getEventId.heureEvent|date('H:i') }}<br>
                                            <i class="fas fa-map-marker-alt me-2"></i><strong>Lieu:</strong> {{ reservation.getEventId.lieuEvent }}
                                        </p>

                                        <!-- Reservation Information -->
                                        <div class="reservation-info mb-4">
                                            <p class="card-text">
                                                <strong>Places réservées:</strong> <span class="badge bg-primary">{{ reservation.getNbPlaces() }} place(s)</span>
                                            </p>
                                            <p class="card-text">
                                                <strong>Statut:</strong> <span class="badge bg-{{ reservation.status == 'active' ? 'success' : (reservation.status == 'canceled' ? 'danger' : 'secondary') }}">
                                                    {{ reservation.status }}
                                                </span>
                                            </p>
                                        </div>

                                        <!-- Actions -->
                                        <div class="d-flex justify-content-end">
                                            {% if reservation.getEventId.dateEvent < now|date('Y-m-d') %}
                                                <span class="text-muted">Cet événement est passé.</span>
                                            {% elseif reservation.status == 'canceled' %}
                                                <span class="text-muted">Cette réservation est annulée.</span>
                                            {% else %}
                                                <a href="{{ path('reservation_edit', {'id': reservation.id}) }}" class="btn btn-outline-primary btn-sm me-2">
                                                    <i class="fas fa-edit"></i> Modifier
                                                </a>
                                                <a href="{{ path('reservation_cancel_confirm', {'id': reservation.id}) }}" class="btn btn-outline-danger btn-sm">
                                                    <i class="fas fa-times"></i> Annuler
                                                </a>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
    <!-- Reservations Section End -->
{% endblock %}