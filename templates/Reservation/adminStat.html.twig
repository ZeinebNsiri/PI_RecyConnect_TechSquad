{% extends 'base2.html.twig' %}

{% block title %}Statistiques des Réservations{% endblock %}

{% block body %}
<main id="main" class="main">
    <section id="stats" class="stats section py-3"> <!-- Reduced padding -->
        <div class="container" data-aos="fade-up">
            <!-- Page Title -->

            <!-- Card for Popular Events Chart -->
            <div class="card shadow-sm mb-4"> <!-- Reduced shadow and margin -->
                <div class="card-body p-3"> <!-- Reduced padding -->
                    <!-- Chart Description -->
                    <p class="text-muted mb-3 fs-6"> <!-- Smaller font size -->
                        <i class="fas fa-chart-pie me-2 text-success"></i>
                        Les événements ayant enregistré le plus grand nombre de réservations.
                    </p>

                    <!-- Chart Container -->
                    <div class="chart-container" style="position: relative; height: 300px; width: 100%;"> <!-- Reduced height -->
                        <canvas id="popularEventsChart"></canvas>
                    </div>

                    <!-- Additional Stats -->
                    <div class="mt-3">
                        <h4 class="fw-bold mb-2 fs-5">Détails des Réservations</h4> <!-- Smaller font size -->
                        <div class="row">
                            {% for event in popularEvents %}
                                <div class="col-md-6 mb-2"> <!-- Reduced margin -->
                                    <div class="card border-0 shadow-sm h-100">
                                        <div class="card-body p-2"> <!-- Reduced padding -->
                                            <h5 class="card-title fw-bold fs-6">{{ event.nomEvent }}</h5> <!-- Smaller font size -->
                                            <p class="card-text text-muted mb-1"> <!-- Reduced margin -->
                                                <i class="fas fa-ticket-alt me-2 text-primary"></i>
                                                <strong>Réservations:</strong> {{ event.total_reservations|round(0, 'floor') }}
                                            </p>
                                            <p class="card-text text-muted mb-1"> <!-- Reduced margin -->
                                                <i class="fas fa-calendar-alt me-2 text-primary"></i>
                                                <strong>Date:</strong> {{ event.dateEvent|date('d/m/Y') }}
                                            </p>
                                            <p class="card-text text-muted mb-1"> <!-- Reduced margin -->
                                                <i class="fas fa-map-marker-alt me-2 text-primary"></i>
                                                <strong>Lieu:</strong> {{ event.lieuEvent }}
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            </div>

            <!-- Card for Capacity Utilization Chart -->
            <div class="card shadow-sm mb-4"> <!-- Reduced shadow and margin -->
                <div class="card-body p-3"> <!-- Reduced padding -->
                    <!-- Chart Description -->
                    <p class="text-muted mb-3 fs-6"> <!-- Smaller font size -->
                        <i class="fas fa-chart-bar me-2 text-success"></i>
                        Taux d'utilisation de la capacité des événements.
                    </p>

                    <!-- Chart Container -->
                    <div class="chart-container" style="position: relative; height: 300px; width: 100%;"> <!-- Reduced height -->
                        <canvas id="capacityUtilizationChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Chart.js Script -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Popular Events Chart (Doughnut)
        var ctx = document.getElementById('popularEventsChart').getContext('2d');
        var popularEventsChart = new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: [{% for event in popularEvents %}"{{ event.nomEvent }}"{% if not loop.last %},{% endif %}{% endfor %}],
                datasets: [{
                    label: 'Nombre de Réservations',
                    data: [{% for event in popularEvents %}{{ event.total_reservations|round(0, 'floor') }}{% if not loop.last %},{% endif %}{% endfor %}],
                    backgroundColor: [
                        'rgba(75, 192, 192, 0.7)',
                        'rgba(54, 162, 235, 0.7)',
                        'rgba(255, 99, 132, 0.7)',
                        'rgba(255, 206, 86, 0.7)',
                        'rgba(153, 102, 255, 0.7)',
                        'rgba(255, 159, 64, 0.7)'
                    ],
                    borderColor: 'rgba(255, 255, 255, 1)',
                    borderWidth: 2,
                    hoverBackgroundColor: 'rgba(0, 0, 0, 0.9)'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: true,
                        position: 'bottom',
                        labels: {
                            color: 'black',
                            font: {
                                size: 12 // Smaller font size
                            }
                        }
                    },
                    tooltip: {
                        enabled: true,
                        backgroundColor: 'rgba(0,0,0,0.7)',
                        titleFont: {
                            size: 14 // Smaller font size
                        },
                        bodyFont: {
                            size: 12 // Smaller font size
                        }
                    }
                }
            }
        });

        // Capacity Utilization Chart (Bar)
        var ctx2 = document.getElementById('capacityUtilizationChart').getContext('2d');
        var capacityUtilizationChart = new Chart(ctx2, {
            type: 'bar',
            data: {
                labels: [{% for event in capacityUtilization %}"{{ event.event_name }}"{% if not loop.last %},{% endif %}{% endfor %}],
                datasets: [{
                    label: 'Taux d\'utilisation (%)',
                    data: [{% for event in capacityUtilization %}{{ (event.total_reservations / event.capacity * 100)|round(2) }}{% if not loop.last %},{% endif %}{% endfor %}],
                    backgroundColor: 'rgba(75, 192, 192, 0.7)',
                    borderColor: 'rgba(75, 192, 192, 1)',
                    borderWidth: 2
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: {
                        beginAtZero: true,
                        max: 100, // Percentage scale
                        title: {
                            display: true,
                            text: 'Taux d\'utilisation (%)'
                        }
                    },
                    x: {
                        title: {
                            display: true,
                            text: 'Événements'
                        }
                    }
                },
                plugins: {
                    legend: {
                        display: true,
                        position: 'top',
                        labels: {
                            color: 'black',
                            font: {
                                size: 12 // Smaller font size
                            }
                        }
                    },
                    tooltip: {
                        enabled: true,
                        backgroundColor: 'rgba(0,0,0,0.7)',
                        titleFont: {
                            size: 14 // Smaller font size
                        },
                        bodyFont: {
                            size: 12 // Smaller font size
                        }
                    }
                }
            }
        });
    </script>
</main>
{% endblock %}