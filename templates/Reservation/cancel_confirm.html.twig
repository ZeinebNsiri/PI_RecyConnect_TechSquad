{% extends 'basecnx.html.twig' %}

{% block title %}Annuler la Réservation - RecyConnect{% endblock %}

{% block body %}
    <!-- Page Header Start -->
    <div class="container-fluid page-header py-5 mb-5 wow fadeIn" data-wow-delay="0.1s" style="background: linear-gradient(rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.6)), url('{{ asset('images/header-bg.jpg') }}') center/cover no-repeat;">
        <div class="container text-center py-5">
            <h1 class="display-4 text-white mb-4 animated slideInDown fw-bold">Annuler la Réservation</h1>
            <nav aria-label="breadcrumb animated slideInDown">
                <ol class="breadcrumb justify-content-center mb-0">
                    <li class="breadcrumb-item"><a href="{{ path('events_list') }}" class="text-white">Accueil</a></li>
                    <li class="breadcrumb-item"><a href="{{ path('reservations_list') }}" class="text-white">Mes Réservations</a></li>
                    <li class="breadcrumb-item text-white active" aria-current="page">Annuler la Réservation</li>
                </ol>
            </nav>
        </div>
    </div>
    <!-- Page Header End -->

    <!-- Cancel Reservation Section Start -->
    <div class="container-xxl py-5">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-8">
                    <div class="card border-0 shadow-lg wow fadeInUp" data-wow-delay="0.1s">
                        <div class="card-body p-4 p-md-5">
                            <!-- Confirmation Title -->
                            <h2 class="card-title fw-bold mb-4 text-center text-dark">
                                Confirmer l'Annulation
                            </h2>

                            <!-- Reservation Details -->
                            <div class="reservation-details mb-4">
                                <div class="mb-3">
                                    <p class="mb-2 text-muted"><i class="fas fa-calendar-alt me-2 text-primary"></i><strong>Événement:</strong></p>
                                    <p class="mb-0 fs-5">{{ reservation.getEventId().nomEvent }}</p>
                                </div>
                                <div class="mb-3">
                                    <p class="mb-2 text-muted"><i class="fas fa-user me-2 text-primary"></i><strong>Nom du participant:</strong></p>
                                    <p class="mb-0 fs-5">{{ reservation.getUser Id().nomUser  }} {{ reservation.getUser Id().prenom }}</p>
                                </div>
                                <div class="mb-3">
                                    <p class="mb-2 text-muted"><i class="fas fa-ticket-alt me-2 text-primary"></i><strong>Places réservées:</strong></p>
                                    <p class="mb-0 fs-5"><span class="badge bg-primary">{{ reservation.getNbPlaces() }} place(s)</span></p>
                                </div>
                                <div class="mb-3">
                                    <p class="mb-2 text-muted"><i class="fas fa-info-circle me-2 text-primary"></i><strong>Statut:</strong></p>
                                    <p class="mb-0 fs-5">
                                        <span class="badge bg-{{ reservation.status == 'active' ? 'success' : (reservation.status == 'canceled' ? 'danger' : 'secondary') }}">
                                            {{ reservation.status }}
                                        </span>
                                    </p>
                                </div>
                            </div>

                            <!-- Confirmation Form -->
                            <form action="{{ path('reservation_cancel', {'id': reservation.id}) }}" method="POST">
                                <input type="hidden" name="_method" value="POST">
                                <input type="hidden" name="_token" value="{{ csrf_token('cancel' ~ reservation.id) }}">

                                <!-- Buttons -->
                                <div class="d-grid gap-3 d-md-flex justify-content-md-center mt-4">
                                    <button type="submit" class="btn btn-danger btn-lg w-100 w-md-auto shadow-sm rounded-pill">
                                        <i class="fas fa-check me-2"></i> Oui, annuler la réservation
                                    </button>
                                    <a href="{{ path('reservations_list') }}" class="btn btn-outline-secondary btn-lg w-100 w-md-auto shadow-sm rounded-pill">
                                        <i class="fas fa-arrow-left me-2"></i> Non, retour à la liste
                                    </a>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Cancel Reservation Section End -->

    <!-- Custom CSS for Additional Styling -->
    <style>
        .page-header {
            background: linear-gradient(rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.6)), url('{{ asset('images/header-bg.jpg') }}') center/cover no-repeat;
        }
        .reservation-details p {
            margin: 0;
        }
        .reservation-details .badge {
            font-size: 1rem;
        }
        .btn {
            transition: background-color 0.3s, color 0.3s;
        }
        .btn-danger:hover {
            background-color: #c82333;
            color: white;
        }
        .btn-outline-secondary:hover {
            background-color: #6c757d;
            color: white;
        }
    </style>
{% endblock %}