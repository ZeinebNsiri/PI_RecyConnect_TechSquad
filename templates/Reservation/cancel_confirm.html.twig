{% extends 'basecnx.html.twig' %}

{% block title %}Annuler la Réservation - RecyConnect{% endblock %}

{% block body %}
    <!-- Page Header Start -->
    <div class="container-fluid page-header py-5 mb-5 wow fadeIn" data-wow-delay="0.1s">
        <div class="container text-center py-5">
            <h1 class="display-3 text-white mb-4 animated slideInDown">Annuler la Réservation</h1>
            <nav aria-label="breadcrumb animated slideInDown">
                <ol class="breadcrumb justify-content-center mb-0">
                    <li class="breadcrumb-item"><a href="{{ path('events_list') }}" class="text-white">Accueil</a></li>
                    <li class="breadcrumb-item"><a href="{{ path('reservations_list') }}" class="text-white">Mes Réservations</a></li>
                    <li class="breadcrumb-item text-white active" aria-current="page">Annuler la Réservation</li>
                </ol>
            </nav>
        </div>
    </div>
    <!-- Page Header End -->

    <!-- Cancel Reservation Section Start -->
    <div class="container-xxl py-5">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-8 offset-lg-2">
                    <div class="card border-0 shadow-lg wow fadeInUp" data-wow-delay="0.1s">
                        <div class="card-body p-4">
                            <!-- Confirmation Title -->
                            <h2 class="card-title fw-bold mb-4 text-center text-primary">
                                Confirmer l'Annulation
                            </h2>

                            <!-- Reservation Details -->
                            <div class="reservation-details mb-4">
                                <p class="card-text">
                                    <i class="fas fa-calendar-alt me-2"></i><strong>Événement:</strong> {{ reservation.getEventId.nomEvent }}
                                </p>
                                <p class="card-text">
                                    <i class="fas fa-user me-2"></i><strong>Nom du participant:</strong> {{ reservation.getUserId.nomUser }} {{ reservation.getUserId.prenom }}
                                </p>
                                <p class="card-text">
                                    <i class="fas fa-ticket-alt me-2"></i><strong>Places réservées:</strong> <span class="badge bg-primary">{{ reservation.getNbPlaces() }} place(s)</span>
                                </p>
                                <p class="card-text">
                                    <i class="fas fa-info-circle me-2"></i><strong>Statut:</strong> <span class="badge bg-{{ reservation.status == 'active' ? 'success' : (reservation.status == 'canceled' ? 'danger' : 'secondary') }}">
                                        {{ reservation.status }}
                                    </span>
                                </p>
                            </div>

                            <!-- Confirmation Form -->
                            <form action="{{ path('reservation_cancel', {'id': reservation.id}) }}" method="POST">
                                <input type="hidden" name="_method" value="POST">
                                <input type="hidden" name="_token" value="{{ csrf_token('cancel' ~ reservation.id) }}">

                                <!-- Buttons -->
                                <div class="d-flex justify-content-between gap-3 mt-4">
                                    <button type="submit" class="btn btn-success btn-lg py-3 px-5 fw-bold">
                                        <i class="fas fa-check me-2"></i> Oui, annuler la réservation
                                    </button>
                                    <a href="{{ path('reservations_list') }}" class="btn btn-secondary btn-lg py-3 px-5 fw-bold">
                                        <i class="fas fa-arrow-left me-2"></i> Non, retour à la liste
                                    </a>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Cancel Reservation Section End -->
{% endblock %}