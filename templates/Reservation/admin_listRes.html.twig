{% extends 'base2.html.twig' %}

{% block title %}Gestion des Réservations{% endblock %}

{% block body %}
<main id="main" class="main">
    <div class="container mt-4">
        <div class="card">
            <div class="card-body">
                <h1 class="card-title mb-4">Gestion des Réservations</h1>

                <!-- Search Form -->
                <form method="get" action="{{ path('admin_reservations_list') }}" class="mb-4">
                    <div class="row g-3">
                        <div class="col-md-3">
                            <input type="text" name="eventName" class="form-control" placeholder="Nom de l'événement"
                                   value="{{ app.request.query.get('eventName') }}">
                        </div>
                        <div class="col-md-3">
                            <input type="text" name="username" class="form-control" placeholder="Nom d'utilisateur"
                                   value="{{ app.request.query.get('username') }}">
                        </div>
                        <div class="col-md-3">
                            <select name="status" class="form-control">
                                <option value="">Tous les statuts</option>
                                <option value="active" {{ app.request.query.get('status') == 'active' ? 'selected' : '' }}>Active</option>
                                <option value="canceled" {{ app.request.query.get('status') == 'canceled' ? 'selected' : '' }}>Annulée</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-search"></i> Rechercher
                            </button>
                        </div>
                    </div>
                </form>

            

                    <!-- Reservations Table -->
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead class="text-center bg-light">
                                <tr>
                                    <th>#</th>
                                    <th>Événement</th>
                                    <th>Utilisateur</th>
                                    <th>Email</th>
                                    <th>Numéro de téléphone</th>
                                    <th>Demandes spéciales</th>
                                    <th>Statut</th>
                                    <th>Places</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for reservation in reservations %}
                                    <tr>
                                  
                                        <th>{{ loop.index }}</th>
                                        <td>{{ reservation.getEventId().getNomEvent() }}</td>
                                        <td>{{ reservation.getUserId() ? reservation.getUserId().getnomUser() : 'N/A' }}</td>
                                        <td>{{ reservation.getEmail() }}</td>
                                        <td>{{ reservation.getNumTel() }}</td>
                                        <td>{{ reservation.getDemandesSpeciales() }}</td>
                                        <td>{{ reservation.getStatus() }}</td>
                                        <td>{{ reservation.getNbPlaces() }}</td>
                                        <td>
                                            <a href="{{ path('delete_reservation_confirm', {'id': reservation.id}) }}" class="btn btn-danger btn-sm">
                                                <i class="fas fa-trash"></i> Supprimer
                                            </a>
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="10" class="text-center">Aucune réservation trouvée.</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </form>
                <li>
         <a href="{{ path('admin_stats') }}">
        📊 Statistiques des Réservations
    </a>
</li>   

            </div>
        </div>
    </div>
</main>


{% endblock %}