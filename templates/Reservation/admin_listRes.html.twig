{% extends 'base2.html.twig' %}

{% block title %}Gestion des Réservations{% endblock %}

{% block body %}
<main id="main" class="main">
    <div class="container mt-5">
        <div class="card shadow-lg">
            <div class="card-body p-5">
                <!-- Page Title -->
                <h1 class="card-title text-center mb-4 display-4 fw-bold">Gestion des Réservations</h1>

                <!-- Search Form -->
                <form method="get" action="{{ path('admin_reservations_list') }}" class="mb-4">
                    <div class="row g-3">
                        <!-- Search by Event Name -->
                        <div class="col-md-3">
                            <input type="text" name="eventName" class="form-control shadow-sm" placeholder="Nom de l'événement"
                                   value="{{ app.request.query.get('eventName') }}">
                        </div>

                        <!-- Search by Username -->
                        <div class="col-md-3">
                            <input type="text" name="username" class="form-control shadow-sm" placeholder="Nom d'utilisateur"
                                   value="{{ app.request.query.get('username') }}">
                        </div>

                        <!-- Filter by Status -->
                        <div class="col-md-3">
                            <select name="status" class="form-select shadow-sm">
                                <option value="">Tous les statuts</option>
                                <option value="active" {{ app.request.query.get('status') == 'active' ? 'selected' : '' }}>Active</option>
                                <option value="canceled" {{ app.request.query.get('status') == 'canceled' ? 'selected' : '' }}>Annulée</option>
                            </select>
                        </div>

                        <!-- Search Button -->
                        <div class="col-md-3">
                            <button type="submit" class="btn btn-primary w-100 shadow-sm hover-scale">
                                <i class="bi bi-search me-2"></i> Rechercher
                            </button>
                        </div>
                    </div>
                </form>

                <!-- Reservations Table -->
                <div class="table-responsive">
                    <table class="table table-borderless">
                        <thead class="table-light">
                            <tr class="text-center">
                                <th>#</th>
                                <th>Événement</th>
                                <th>Utilisateur</th>
                                <th>Email</th>
                                <th>Numéro de téléphone</th>
                                <th>Demandes spéciales</th>
                                <th>Statut</th>
                                <th>Places</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for reservation in reservations %}
                                <tr class="align-middle text-center">
                                    <th>{{ loop.index }}</th>
                                    <td>{{ reservation.getEventId().getNomEvent() }}</td>
                                    <td>{{ reservation.getUserId() ? reservation.getUserId().getnomUser() : 'N/A' }}</td>
                                    <td>{{ reservation.getEmail() }}</td>
                                    <td>{{ reservation.getNumTel() }}</td>
                                    <td>{{ reservation.getDemandesSpeciales() }}</td>
                                    <td>
                                        <span class="badge bg-{{ reservation.getStatus() == 'active' ? 'success' : 'danger' }}">
                                            {{ reservation.getStatus() }}
                                        </span>
                                    </td>
                                    <td>{{ reservation.getNbPlaces() }}</td>
                                    <td>
                                        <a href="{{ path('delete_reservation_confirm', {'id': reservation.id}) }}" class="btn btn-danger btn-sm shadow-sm hover-scale">
                                            <i class="fas fa-trash me-2"></i> Supprimer
                                        </a>
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="9" class="text-center text-muted py-4">Aucune réservation trouvée.</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>

                <!-- Statistics Link -->
                <div class="text-end mt-4">
                    <a href="{{ path('admin_stats') }}" class="btn btn-info shadow-sm hover-scale">
                        <i class="fas fa-chart-bar me-2"></i> Statistiques des Réservations
                    </a>
                </div>
            </div>
        </div>
    </div>
</main>
{% endblock %}