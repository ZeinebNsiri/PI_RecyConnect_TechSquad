{% extends 'base2.html.twig' %}

{% block title %}Gestion des Événements{% endblock %}

{% block body %}
<main id="main" class="main">

  <div class="card">
    <div class="card-body">
      <h5 class="card-title">Gestion des Événements</h5>

      <!-- Search Form -->
      <form method="get" action="{{ path('admin_events') }}" class="mb-4">
        <div class="row g-3">
          <div class="col-md-4">
            <input type="text" name="search" class="form-control" placeholder="Rechercher un événement" value="{{ searchTerm }}">
          </div>
          <div class="col-md-3">
            <input type="text" name="location" class="form-control" placeholder="Lieu" value="{{ location }}">
          </div>
          <div class="col-md-3">
            <input type="date" name="date" class="form-control" value="{{ date }}">
          </div>
          <div class="col-md-2">
            <button type="submit" class="btn btn-primary">
              <i class="bi bi-search"></i> Rechercher
            </button>
          </div>
        </div>
      </form>

      <!-- Add Event Button -->
      <div class="d-flex justify-content-between align-items-center mb-4">
        <a href="{{ path('create_event') }}" class="btn btn-success">
          <i class="fas fa-plus"></i> Ajouter événement
        </a>
      </div>

      <!-- Events Table -->
      <table class="table table-hover">
        <thead class="text-center bg-light">
          <tr>
            <th>#</th>
            <th>Image</th>
            <th>Nom</th>
            <th>Lieu</th>
            <th>Date</th>
            <th>Heure</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          {% for event in events %}
            <tr class="align-middle text-center">
              <th>{{ loop.index }}</th>
              <td>
                {% if event.imageEvent %}
                  <img src="{{ asset('uploads/images/' ~ event.imageEvent) }}" alt="Event Image" height="80">
                {% else %}
                  <span class="text-muted">No Image</span>
                {% endif %}
              </td>
              <td>{{ event.nomEvent }}</td>
              <td>{{ event.lieuEvent }}</td>
              <td>{{ event.dateEvent|date('Y-m-d') }}</td>
              <td>{{ event.heureEvent|date('H:i') }}</td>
              <td>
                <div class="d-flex justify-content-center gap-2">
                  <a href="{{ path('edit_event', {'id': event.id}) }}" class="btn btn-success">
                    <i class="bi bi-pencil-square"></i> Modifier
                  </a>
                  <a href="{{ path('delete_event_confirm', {'id': event.id}) }}" class="btn btn-danger">
                    <i class="bi bi-trash"></i> Supprimer
                  </a>
                </div>
              </td>
            </tr>
          {% else %}
            <tr>
              <td colspan="7" class="text-center text-muted">Aucun événement trouvé.</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</main>
{% endblock %}