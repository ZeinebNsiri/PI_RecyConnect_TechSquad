{% extends 'basecnx.html.twig' %}

{% block title %}Événements{% endblock %}

{% block body %}
  <!-- Page Header Start -->
  <div class="container-fluid page-header py-5 mb-5 wow fadeIn" data-wow-delay="0.1s">
    <div class="container text-center py-5">
      <h1 class="display-3 text-white mb-4 animated slideInDown">Événements</h1>
      <nav aria-label="breadcrumb animated slideInDown">
        <ol class="breadcrumb justify-content-center mb-0">
          <li class="breadcrumb-item"><a href="{{ path('home') }}" class="text-white">Accueil</a></li>
          <li class="breadcrumb-item text-white active" aria-current="page">Événements</li>
        </ol>
      </nav>
    </div>
  </div>
  <!-- Page Header End -->

  <!-- Search Form Start -->
  <div class="container-xxl py-5">
    <div class="container">
      <div class="bg-light rounded p-4 p-sm-5 wow fadeInUp" data-wow-delay="0.1s">
        <h2 class="mb-4">Rechercher un Événement</h2>
        <form action="{{ path('events_list') }}" method="get" class="row g-3">
          <div class="col-md-6 col-lg-3">
            <input type="text" id="eventName" name="name" class="form-control form-control-lg" placeholder="Nom de l'événement" value="{{ name }}">
          </div>
          <div class="col-md-6 col-lg-3">
            <input type="text" name="location" class="form-control form-control-lg" placeholder="Lieu" value="{{ location }}">
          </div>
          <div class="col-md-6 col-lg-2">
            <input type="date" name="date" class="form-control form-control-lg" value="{{ date }}">
          </div>
          <div class="col-md-6 col-lg-2">
            <select name="type" class="form-select form-select-lg">
              <option value="">Tous les types</option>
              <option value="en ligne" {% if type == 'en ligne' %}selected{% endif %}>En ligne</option>
              <option value="sur site" {% if type == 'sur site' %}selected{% endif %}>Sur site</option>
            </select>
          </div>
          <div class="col-md-12 col-lg-2">
            <button type="submit" class="btn btn-primary btn-lg w-100">Rechercher</button>
          </div>
        </form>
      </div>
    </div>
  </div>
  <!-- Search Form End -->

  <!-- Events Section Start -->
  <div class="container-xxl py-5">
    <div class="container">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Événements</h2>
        <div>
          <a href="{{ path('reservations_list') }}" class="btn btn-primary me-2">Mes Réservations</a>
          <a href="{{ path('event_recommendations') }}" class="btn btn-primary me-2">Événements Recommandés</a>
        </div>
      </div>
      <div class="row g-4">
        {% for event in events %}
          <div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="0.1s">
            <div class="card border-0 shadow-lg h-100">
              <img src="{{ asset('uploads/images/' ~ event.imageEvent) }}" class="card-img-top rounded-top" alt="{{ event.nomEvent }}" style="height: 200px; object-fit: cover;">
              <div class="card-body p-4">
                <h5 class="card-title fw-bold">{{ event.nomEvent }}</h5>
                <p class="card-text">{{ event.descriptionEvent }}</p>
                <p class="card-text"><small class="text-muted">{{ event.lieuEvent }}</small></p>
                <a href="{{ path('event_show', {'id': event.id}) }}" class="btn btn-primary">Voir plus</a>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
  <!-- Events Section End -->

  <!-- JavaScript for Dynamic Search -->
  <script>
    document.getElementById('eventName').addEventListener('input', function() {
      const query = this.value;
      if (query.length >= 2) {
        fetch(`/events/search?name=${query}`)
          .then(response => response.json())
          .then(data => {
            // Handle the data (e.g., display suggestions)
            console.log(data);
          });
      }
    });
  </script>
{% endblock %}