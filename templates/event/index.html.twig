{% extends 'base2.html.twig' %}

{% block title %}Gestion des Événements{% endblock %}

{% block body %}
<main id="main" class="main">
    {% for message in app.flashes('success') %}
        <div class="alert alert-success bg-success text-light border-0 alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}

    <div class="container mt-4">
        <div class="card">
            <div class="card-body">
                <h1 class="card-title mb-4">Gestion des Événements</h1>

                <!-- Search Form -->
                <form method="get" action="{{ path('events_list') }}" class="mb-4">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <input type="text" name="location" class="form-control" placeholder="Lieu" value="{{ location }}">
                        </div>
                        <div class="col-md-4">
                            <input type="date" name="date" class="form-control" value="{{ date }}">
                        </div>
                        <div class="col-md-4">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-search"></i> Rechercher
                            </button>
                        </div>
                    </div>
                </form>

                <!-- Events Table -->
                <h2>Événements en Ligne</h2>
                <table class="table table-hover">
                    <thead class="text-center bg-light">
                        <tr>
                            <th>#</th>
                            <th>Nom</th>
                            <th>Lieu</th>
                            <th>Date</th>
                            <th>Heure</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for event in onlineEvents %}
                            <tr class="align-middle text-center">
                                <th>{{ loop.index }}</th>
                                <td>{{ event.nomEvent }}</td>
                                <td>{{ event.lieuEvent }}</td>
                                <td>{{ event.dateEvent|date('Y-m-d') }}</td>
                                <td>{{ event.heureEvent|date('H:i') }}</td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="5" class="text-center text-muted">Aucun événement en ligne trouvé.</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>

                <h2>Événements sur Site</h2>
                <table class="table table-hover">
                    <thead class="text-center bg-light">
                        <tr>
                            <th>#</th>
                            <th>Nom</th>
                            <th>Lieu</th>
                            <th>Date</th>
                            <th>Heure</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for event in onsiteEvents %}
                            <tr class="align-middle text-center">
                                <th>{{ loop.index }}</th>
                                <td>{{ event.nomEvent }}</td>
                                <td>{{ event.lieuEvent }}</td>
                                <td>{{ event.dateEvent|date('Y-m-d') }}</td>
                                <td>{{ event.heureEvent|date('H:i') }}</td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="5" class="text-center text-muted">Aucun événement sur site trouvé.</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>  
    </div>
</main>
{% endblock %}