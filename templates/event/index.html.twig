{% extends 'basecnx.html.twig' %}

{% block title %}Nos Événements{% endblock %}

{% block body %}
  <!-- Page Header Start -->
  <div class="container-fluid page-header py-5 mb-5 wow fadeIn" data-wow-delay="0.1s" style="background: linear-gradient(rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.6)), url('{{ asset('uploads/images/carousel-1.jpg') }}') center/cover no-repeat;">
    <div class="container text-center py-5">
      <h1 class="display-3 text-white mb-4 animated slideInDown">Nos Événements</h1>
      <nav aria-label="breadcrumb" class="animated slideInDown">
        <ol class="breadcrumb justify-content-center mb-0">
          <li class="breadcrumb-item"><a href="{{ path('events_list') }}" class="text-white">Événements</a></li>
          <li class="breadcrumb-item active text-white" aria-current="page">Nos Événements</li>
        </ol>
      </nav>
    </div>
  </div>
  <!-- Page Header End -->

  <!-- Events Section Start -->
  <div class="container-xxl py-5">
  

      <!-- Search Filters -->
      <div class="mb-5">
        <form method="get" action="{{ path('events_list') }}" class="row g-3">
          <div class="col-md-4">
            <input type="text" name="location" class="form-control" placeholder="Lieu" value="{{ app.request.query.get('location') }}">
          </div>
          <div class="col-md-4">
            <input type="date" name="date" class="form-control" value="{{ app.request.query.get('date') }}">
          </div>
          <div class="col-md-4">
            <button type="submit" class="btn btn-primary w-100">
              <i class="fa fa-search me-2"></i>Rechercher
            </button>
          </div>
        </form>
      </div>

      <!-- Online Events -->
      <div class="mb-5">
        <h2 class="text-center mb-4 text-primary">Événements en ligne</h2>
        <div class="row g-4">
          {% for event in onlineEvents %}
            <div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="0.1s">
              <div class="card h-100 border-0 shadow-sm transition-transform">
                <div class="card-img-top overflow-hidden" style="height: 200px;">
                  <img class="img-fluid w-100 h-100 object-cover" src="{{ asset(event.getImageEvent() ? 'uploads/images/' ~ event.getImageEvent() : 'img/default.jpg') }}" alt="{{ event.getNomEvent() }}">
                </div>
                <div class="card-body p-4">
                
                  <h4 class="card-title text-center mb-3">{{ event.getNomEvent() }}</h4>
                  <p class="card-text text-center mb-4">{{ event.getDescriptionEvent() }}</p>
                  <p class="text-center text-muted fst-italic mb-4">{{ event.getDateEvent()|date('l d F \\  ') }}</p>
                  <div class="text-center">
                    <a class="btn btn-primary btn-sm rounded-pill px-4" href="{{ path('event_show', {'id': event.getId()}) }}">
                      <i class="fa fa-plus me-2"></i>Savoir plus
                    </a>
                  </div>
                </div>
              </div>
            </div>
          {% else %}
            <p class="text-center text-muted">Aucun événement en ligne pour le moment.</p>
          {% endfor %}
        </div>
      </div>

      <!-- Onsite Events -->
      <div class="mb-5">
        <h2 class="text-center mb-4 text-primary">Événements sur site</h2>
        <div class="row g-4">
          {% for event in onsiteEvents %}
            <div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="0.1s">
              <div class="card h-100 border-0 shadow-sm transition-transform">
                <div class="card-img-top overflow-hidden" style="height: 200px;">
                  <img class="img-fluid w-100 h-100 object-cover" src="{{ asset(event.getImageEvent() ? 'uploads/images/' ~ event.getImageEvent() : 'img/default.jpg') }}" alt="{{ event.getNomEvent() }}">
                </div>
                <div class="card-body p-4">

                  <h4 class="card-title text-center mb-3">{{ event.getNomEvent() }}</h4>
                  <p class="card-text text-center mb-4">{{ event.getDescriptionEvent() }}</p>
                  <p class="text-center text-muted fst-italic mb-4">{{ event.getDateEvent()|date('l d F \\à H\\hi') }}</p>
                  <div class="text-center">
                    <a class="btn btn-primary btn-sm rounded-pill px-4" href="{{ path('event_show', {'id': event.getId()}) }}">
                      <i class="fa fa-plus me-2"></i>Savoir plus
                    </a>
                  </div>
                </div>
              </div>
            </div>
          {% else %}
            <p class="text-center text-muted">Aucun événement sur site pour le moment.</p>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
  <!-- Events Section End -->
{% endblock %}