{% extends 'base2.html.twig' %}

{% block title %}Confirmer la Suppression{% endblock %}

{% block body %}
<main id="main" class="main">
    <div class="container mt-5">
        <div class="card shadow-lg">
            <div class="card-body p-5">
                <!-- Page Title -->
                <h1 class="card-title text-center mb-4 display-4 fw-bold text-danger">Confirmer la Suppression</h1>

                <!-- Warning Alert -->
                <div class="alert alert-warning shadow-sm" role="alert">
                    <h4 class="alert-heading fw-bold">
                        <i class="fas fa-exclamation-triangle me-2"></i>Êtes-vous sûr de vouloir supprimer cet événement ?
                    </h4>
                    <hr>
                    <p class="mb-0">Cette action est irréversible. Toutes les données associées à cet événement seront supprimées.</p>
                </div>

                <!-- Event Details -->
                <div class="mb-4 p-4 bg-light rounded shadow-sm">
                    <p class="mb-2"><strong><i class="fas fa-calendar-alt me-2"></i>Événement:</strong> {{ event.nomEvent }}</p>
                    <p class="mb-2"><strong><i class="fas fa-clock me-2"></i>Date:</strong> {{ event.dateEvent|date('d/m/Y') }}</p>
                    <p class="mb-0"><strong><i class="fas fa-map-marker-alt me-2"></i>Lieu:</strong> {{ event.lieuEvent }}</p>
                </div>

                <!-- Confirmation Form -->
                <form action="{{ path('delete_event', {'id': event.id}) }}" method="POST">
                    <input type="hidden" name="_method" value="POST">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ event.id) }}">

                    <!-- Buttons -->
                    <div class="text-center d-flex justify-content-center gap-3">
                        <button type="submit" class="btn btn-danger btn-lg shadow-sm hover-scale">
                            <i class="fas fa-trash me-2"></i> Oui, supprimer
                        </button>
                        <a href="{{ path('admin_events') }}" class="btn btn-secondary btn-lg shadow-sm hover-scale">
                            <i class="fas fa-times me-2"></i> Non, annuler
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</main>
{% endblock %}