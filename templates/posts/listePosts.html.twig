{% extends 'base2.html.twig' %}

{% block title %}Gestion des Posts{% endblock %}

{% block body %}
<main id="main" class="main">
    <h1>Gestion des Posts</h1>

    <!-- Card du Line Chart -->
    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">Nombre de Posts par Mois</h5>
            <div id="lineChart"></div>
        </div>
    </div>
    
    <table class="table table-hover">
        <thead class="thead-dark">
            <tr>
                <th>ID</th>
                <th>Auteur</th>
                <th>Contenu</th>
                <th>Créé le</th>
                <th>Statut</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for post in posts %}
                <tr>
                    <td>{{ post.id }}</td>
                    <td>{{ post.userP.NomUser }}</td>
                    <td>{{ post.contenu }}</td>
                    <td>{{ post.datePublication|date('d/m/Y H:i') }}</td>
                    <td>{{ post.StatusPost ? 'Approuvé' : 'En attente' }}</td>
                {#  
                        {% if post.StatusPost %}
                            <span class="badge badge-success">Approuvé</span>
                        {% else %}
                            <span class="badge badge-warning">En attente</span>
                        {% endif %}
                        #}
                    </td>
                    <td>
                        {% if not post.StatusPost %}
                            <a href="{{ path('admin_post_approve', {'id': post.id}) }}" class="btn btn-success btn-sm">Approuver</a>
                        {% else %}
                            <a href="{{ path('admin_post_reject', {'id': post.id}) }}" class="btn btn-warning btn-sm">Rejeter</a>
                        {% endif %}
                        <a class="btn btn-danger delete-btn"data-url="{{ path('admin_post_delete', {'id': post.id}) }}"data-entity="Post"data-genre="f"><i class="bi bi-trash"></i>Supprimer</a>
                        
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
    </main>
{% endblock %}

 {% block javascripts %}

    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const monthlyData = {{ monthlyData|raw }};
            new ApexCharts(document.querySelector("#lineChart"), {
                series: [{
                    name: "Posts",
                    data: monthlyData
                }],
                chart: {
                    height: 350,
                    type: 'line',
                    zoom: {
                        enabled: false
                    }
                },
                dataLabels: {
                    enabled: false
                },
                stroke: {
                    curve: 'smooth'
                },
                grid: {
                    row: {
                        colors: ['#f3f3f3', 'transparent'], // Alternance des couleurs de ligne
                        opacity: 0.5
                    },
                },
                xaxis: {
                    categories: ['Jan', 'Fév', 'Mar', 'Avr', 'Mai', 'Juin', 'Juil', 'Aoû', 'Sep', 'Oct', 'Nov', 'Déc']
                }
            }).render();
        });
    </script>
 {% endblock %}